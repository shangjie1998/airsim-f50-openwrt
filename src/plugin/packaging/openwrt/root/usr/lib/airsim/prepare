#!/bin/sh
set -eu
if [ -x /usr/lib/airsim/audio-setup ]; then
 state=$(/usr/lib/airsim/audio-setup --status)
 case "$state" in
  ready) ;;
  reboot_required) echo 'Restart into OpenWrt once; audio setup resumes automatically before AirSIM.' >&2; exit 1 ;;
  *) echo 'Audio setup has not completed. Check the installation error before starting AirSIM.' >&2; exit 1 ;;
 esac
fi
# Optional root-owned hardware preparation retained across plugin upgrades.
# The package does not create this override or enable driver-version bypasses.
if [ -f /etc/airsim/prepare.local ]; then
	exec /bin/sh /etc/airsim/prepare.local
fi
export PATH="/usr/lib/airsim/bin:$PATH:/opt/mu300/bin:/opt/mu300/busybox-bin"
# Firmware/kernel release numbers do not gate startup. Reuse the installed
# audio stack; never auto-install the bundled legacy kernel modules.
for c in mu300-at mu300-voice mu300-audio-dsp; do
	command -v "$c" >/dev/null || { echo "Missing $c; install mu300-audio and the required MU300 tools for this device" >&2; exit 1; }
done
if [ ! -f /lib/firmware/agdsp.bin ]; then
	mu300-audio-dsp install --download
fi
for c in amixer aplay arecord; do command -v "$c" >/dev/null || { echo "Missing $c" >&2; exit 1; }; done
umask 077
mkdir -p /mnt/mu300-disk/extra/airsim/data
# Do not transfer hardware ownership during a live call.
if mu300-at 'AT+CLCC' | grep -q '+CLCC:'; then
	echo 'Finish the current call before starting AirSIM' >&2
	exit 1
fi
# One owner of scene teardown. Stop the upstream follower before starting ours.
if [ -x /etc/init.d/mu300-voice ]; then
	/etc/init.d/mu300-voice stop >/dev/null 2>&1 || true
	if [ -L /etc/rc.d/S96mu300-voice ]; then
		mv /etc/rc.d/S96mu300-voice /mnt/mu300-disk/extra/airsim/upstream-voice-startup
	fi
fi
# start is idempotent when the DSP is already running; never call stop/reset.
#
# 音频驱动与内核强绑定：mu300-linux 换内核 release 后，/mnt 上的驱动包很可能
# 只有旧版本的 .ko。此时 DSP 必炸，但插件本体（页面、短信、来电通知）仍可用。
# 所以这里先做一次自检，再决定是否启动 DSP：
#   - 目录约定 $EXTRA/modules/<KREL>/，同一 KREL 多套构建时 <KREL>+<tag>/
#   - 判据是 vermagic 与 uname -r 完全对齐，不看目录名
#   - 不匹配 → 自动写 /etc/airsim/no-audio（首行 auto: 说明原因），跳过 DSP
#   - 之后再匹配上（比如系统回滚/驱动补齐）→ 自动删掉 auto 标记，恢复语音
#   - 手工写的标记（内容不以 auto: 开头）永远尊重，不会被自动清掉
AUDIO_EXTRA=${AIRSIM_AUDIO_EXTRA:-/mnt/mu300-disk/extra/airsim-audio}
FLAG_DIR=/etc/airsim
FLAG=$FLAG_DIR/no-audio
KREL=$(uname -r)

vermagic_of() {
	grep -ao 'vermagic=[^[:space:]]*' "$1" 2>/dev/null | head -n 1 | cut -d= -f2
}

audio_extra_for_kernel() {
	_c=
	for _d in "$AUDIO_EXTRA/modules/$KREL" "$AUDIO_EXTRA/modules/$KREL"+*; do
		[ -d "$_d" ] || continue
		[ -f "$_d/audio_reserve.ko" ] || continue
		_v=$(vermagic_of "$_d/audio_reserve.ko")
		case $_v in "$KREL"|"$KREL "*) _c=$_d; break ;; esac
	done
	[ -n "$_c" ] && { echo "$_c"; return 0; }
	return 1
}

known_krels() {
	ls "$AUDIO_EXTRA/modules" 2>/dev/null | tr '\n' ' '
}

if [ -f "$FLAG" ]; then
	_note=$(cat "$FLAG" 2>/dev/null || true)
	if [ "${_note#auto}" != "$_note" ] && _dir=$(audio_extra_for_kernel); then
		rm -f "$FLAG"
		logger -t airsim "audio drivers for $KREL found again ($_dir); resuming DSP"
	elif [ "${_note#auto}" != "$_note" ]; then
		logger -t airsim "audio skipped: kernel $KREL has no matching drivers (have: $(known_krels))"
	else
		logger -t airsim "audio skipped: manual flag $FLAG"
	fi
fi

if [ -f "$FLAG" ]; then
	:  # 跳过 DSP（见上面的日志）
elif _dir=$(audio_extra_for_kernel); then
	if [ ! -f /run/airsim-dsp-prepared ]; then
		mu300-audio-dsp start
		touch /run/airsim-dsp-prepared
	fi
	rm -f "$FLAG_DIR/no-audio.reason"
else
	mkdir -p "$FLAG_DIR"
	{
		echo "auto: kernel $KREL has no matching audio drivers"
		echo "kernel: $KREL"
		echo "available: $(known_krels)"
		echo "path: $AUDIO_EXTRA/modules"
		echo "note: 语音不可用，页面/短信/来电通知正常。装好对应内核的驱动后重启一次或 restart 服务，会自动恢复。"
	} > "$FLAG"
	logger -t airsim "audio drivers for $KREL missing (have: $(known_krels)); DSP skipped"
	echo "音频驱动与内核 $KREL 不匹配（现有：$(known_krels)），本次跳过 DSP：语音不可用，其余功能正常。" >&2
fi
