#!/bin/sh
# mu300-at 兼容层。
#
# Agent 的调用形式是 mu300-at -t N - ，末尾的 `-` 表示「命令从 stdin 读」。
# 新版厂商脚本只认 argv，不认识 `-`，会把它当成一条 AT 命令原样发给基带，
# 于是回 +CME ERROR: 0 而且退出码仍是 0 —— 静默失败，上层只看到「读不到号码」。
# 详见 docs/经验库/mu300-at-stdin-mode-mismatch.md。
#
# 这里不判定版本，只看真正的脚本自己会不会处理 `-`：会，就原样转交；
# 不会，就替它把 stdin 上的命令读出来，按 argv 形式传过去。
REAL=${MU300_AT_REAL:-/opt/mu300/bin/mu300-at}
T=6
if [ "${1:-}" = "-t" ]; then
    T=${2:-6}
    shift 2
fi
if [ "${1:-}" = "-" ]; then
    if [ -r "$REAL" ] && grep -q 'if \[ "$cmd" = - \]' "$REAL" 2>/dev/null; then
        exec "$REAL" -t "$T" -
    fi
    cmd=
    IFS= read -r cmd || [ -n "$cmd" ] || cmd=
    [ -n "$cmd" ] || { echo "mu300-at: no command on stdin" >&2; exit 2; }
    exec "$REAL" -t "$T" "$cmd"
fi
exec "$REAL" -t "$T" "$@"
