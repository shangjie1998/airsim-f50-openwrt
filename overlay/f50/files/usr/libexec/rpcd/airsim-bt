#!/bin/sh
# AirSIM for F50 —— 蓝牙开关（独立 rpcd 对象 airsim-bt）
#
# 只做一件事：把 /usr/sbin/f50-bt-switch.sh（on/off/status）包成 ubus 方法，
# 让 LuCI 页面不必走 fs.exec 白名单。开关状态持久化在 /etc/config/f50-bt，
# 值为 0 时开机脚本直接跳过拉起 —— 即「关了以后重启仍然是关」。
#
# 返回字段与 M8 的 airsim-bt 对齐（supported/enabled/attached/address/adapter/
# up/bluetoothd/service/label），这样页面可以两端共用一份。
#
# 与上游的关系：不改上游任何文件，ubus 上多一个 airsim-bt 对象。

. /usr/share/libubox/jshn.sh

SW=/usr/sbin/f50-bt-switch.sh
CONF=/etc/config/f50-bt
HCI=/sys/class/bluetooth/hci0

# 可选件（bt-opt）：固定 tag + 固定 sha256，跟主包版本解耦
BT_OPT_TAG=bt-opt-v1.0.3
BT_OPT_FILE=airsim-f50-bt-opt-1.0.3-k6.18.60.tar.gz
BT_OPT_KVER=6.18.60
BT_OPT_DIR=/tmp/airsim-btopt
BT_OPT_RUN=/usr/libexec/airsim-btopt-install

bt_state() {
	en=$(uci -q get f50-bt.settings.enabled 2>/dev/null)
	[ -n "$en" ] || en=unset

	json_init
	json_add_boolean supported 1
	json_add_string label '蓝牙'
	json_add_string service 'sprdbluetooth'
	json_add_string adapter 'hci0'

	if [ "$en" = 1 ]; then json_add_boolean enabled 1; else json_add_boolean enabled 0; fi

	if [ -d "$HCI" ]; then
		json_add_boolean attached 1
	else
		json_add_boolean attached 0
	fi

	# 这个 6.18 内核的 /sys/class/bluetooth/hci0 下没有 address 节点，
	# 地址只能从 hciconfig 的 BD Address 里取；两处都试一次。
	addr=$(cat "$HCI/address" 2>/dev/null | tr -d '\n')
	if [ -z "$addr" ] && command -v hciconfig >/dev/null 2>&1; then
		addr=$(hciconfig hci0 2>/dev/null | sed -n 's/.*BD Address: *\([0-9A-Fa-f:]*\).*/\1/p' | head -n 1)
	fi
	[ -n "$addr" ] && json_add_string address "$addr"

	up=0
	if command -v hciconfig >/dev/null 2>&1; then
		hciconfig hci0 2>/dev/null | grep -qi 'UP RUNNING' && up=1
	else
		[ -d "$HCI" ] && up=1
	fi
	json_add_boolean up "$up"

	bluetoothd=0
	pgrep -f '[b]luetoothd' >/dev/null 2>&1 && bluetoothd=1
	json_add_boolean bluetoothd "$bluetoothd"

	# 显示名：手机蓝牙列表里看到的就是它（attach 脚本算的 F50-<地址后6位>）
	# hciconfig 不带 -a 不打印名字，必须 -a；手机端看到的是这个名字
	nm=$(hciconfig -a hci0 2>/dev/null | sed -n "s/.*Name: *'\(.*\)'.*/\1/p" | head -n 1)
	# hciconfig 读本地名偶尔会 HCI 超时（尤其刚重启 bluetoothd 之后），
	# 这时退回 bluetoothctl：它读的是 bluetoothd 的 alias，也正是手机端看到的名字。
	if [ -z "$nm" ] && command -v bluetoothctl >/dev/null 2>&1; then
		nm=$(bluetoothctl show 2>/dev/null | sed -n 's/^[[:space:]]*Name:[[:space:]]*//p' | head -n 1)
	fi
	[ -n "$nm" ] && json_add_string name "$nm"

	# 可见性：PSCAN=可被发现，ISCAN=可被连接。默认开机就打开，见 airsim-bt-boot。
	discoverable=0
	pairable=0
	if [ -d "$HCI" ] && command -v hciconfig >/dev/null 2>&1; then
		hciconfig hci0 2>/dev/null | grep -q 'PSCAN' && discoverable=1
		hciconfig hci0 2>/dev/null | grep -q 'ISCAN' && pairable=1
	fi
	json_add_boolean discoverable "$discoverable"
	json_add_boolean pairable "$pairable"

	# 已配对设备：BlueZ 每台配对设备存成 /var/lib/bluetooth/<控制器>/<mac>/info，
	# 只有带 [LinkKey] 段的才算真配对。先落临时文件再读，别让 jshn 掉进管道子 shell。
	json_add_array devices
	if [ -n "$addr" ] && [ -d "/var/lib/bluetooth/$addr" ]; then
		_tmp=$(mktemp /tmp/airsim-bt-dev.XXXXXX 2>/dev/null || echo /tmp/airsim-bt-dev.$$)
		_con=$(hcitool con 2>/dev/null)
		for _d in /var/lib/bluetooth/"$addr"/*; do
			[ -d "$_d" ] || continue
			_ma=$(basename "$_d")
			case "$_ma" in cache|settings) continue ;; esac
			_info="$_d/info"
			[ -f "$_info" ] || continue
			grep -q '^\[LinkKey\]' "$_info" 2>/dev/null || continue
			_n=$(sed -n 's/^Name=/ /p' "$_info" 2>/dev/null | head -n 1 | sed 's/^ //')
			_cn=0
			printf '%s' "$_con" | grep -qi "$_ma" && _cn=1
			printf '%s\t%s\t%s\n' "$_ma" "${_n:-未命名}" "$_cn" >> "$_tmp"
		done
		while IFS='	' read -r _a _n _c; do
			[ -n "$_a" ] || continue
			json_add_object
			json_add_string address "$_a"
			json_add_string name "$_n"
			json_add_boolean connected "$_c"
			json_close_object
		done < "$_tmp"
		rm -f "$_tmp"
	fi
	json_close_array

	# 文案要跟着真实状态走：开关记着「开」但 hci0 不存在时，
	# 不能哄人说「可以直接搜到」——那正是页面显示"未挂载"却没人知道原因的那次。
	case "$en" in
	1)
		if [ -d "$HCI" ]; then
			json_add_string hint '控制器已挂载并保持可被发现；手机、耳机可以直接搜到这台设备。'
		else
			json_add_string hint '开关是开的，但控制器还没挂上；稍等十几秒，仍不行就关一次再打开（或重启后由开机脚本重试）。'
		fi
		;;
	unset) json_add_string hint '还没有写过开关配置，按默认（开）处理。' ;;
	*) json_add_string hint '已关闭；打开后控制器才挂载。' ;;
	esac
	json_dump
}

bt_set() {
	IFS= read -r request
	enable=0
	if json_load "$request" 2>/dev/null; then
		json_get_var enable enable 2>/dev/null
	fi
	case "$enable" in
	1|true|on|yes) want=on ;;
	*) want=off ;;
	esac
	if [ ! -x "$SW" ]; then
		json_init
		json_add_boolean ok 0
		json_add_string error '蓝牙脚本不在位（/usr/sbin/f50-bt-switch.sh）'
		json_dump
		return
	fi
	out=$("$SW" "$want" 2>&1)
	# 开关动作顺便把可见性复位：sprdbluetooth 重启后会清掉 PSCAN/ISCAN，
	# 只写 hciconfig 不够，bluetoothd 那边也要 pairable/discoverable 打开。
	if [ "$want" = on ] && [ -d "$HCI" ]; then
		hciconfig hci0 piscan >/dev/null 2>&1
		if command -v bluetoothctl >/dev/null 2>&1; then
			printf 'pairable on\ndiscoverable on\nquit\n' | bluetoothctl >/dev/null 2>&1
		fi
	fi

	json_init
	json_add_boolean ok 1
	json_add_boolean supported 1
	json_add_string label '蓝牙'
	json_add_string service 'sprdbluetooth'
	json_add_string adapter 'hci0'
	if [ "$want" = on ]; then json_add_boolean enabled 1; else json_add_boolean enabled 0; fi
	if [ -d "$HCI" ]; then json_add_boolean attached 1; else json_add_boolean attached 0; fi
	# 这个 6.18 内核的 /sys/class/bluetooth/hci0 下没有 address 节点，
	# 地址只能从 hciconfig 的 BD Address 里取；两处都试一次。
	addr=$(cat "$HCI/address" 2>/dev/null | tr -d '\n')
	if [ -z "$addr" ] && command -v hciconfig >/dev/null 2>&1; then
		addr=$(hciconfig hci0 2>/dev/null | sed -n 's/.*BD Address: *\([0-9A-Fa-f:]*\).*/\1/p' | head -n 1)
	fi
	[ -n "$addr" ] && json_add_string address "$addr"
	up=0
	if command -v hciconfig >/dev/null 2>&1; then
		hciconfig hci0 2>/dev/null | grep -qi 'UP RUNNING' && up=1
	else
		[ -d "$HCI" ] && up=1
	fi
	json_add_boolean up "$up"
	bluetoothd=0
	pgrep -f '[b]luetoothd' >/dev/null 2>&1 && bluetoothd=1
	json_add_boolean bluetoothd "$bluetoothd"
	json_add_string output "$out"
	json_dump
}

# ---- 可选件：探测 / 安装 ----------------------------------------------------
# 主包不带蓝牙那一套。没装过的机器用这两个方法把可选件装回来。
btopt_state() { cat "$BT_OPT_DIR/state" 2>/dev/null | head -1; }
btopt_msg() { cat "$BT_OPT_DIR/msg" 2>/dev/null | head -1; }

btopt_probe() {
	kver=$(uname -r)
	installed=0
	[ -x /usr/bin/bluetoothd ] && [ -x /usr/bin/btattach ] && installed=1

	busy=0
	case "$(btopt_state)" in
		download|verify|extract|install) busy=1 ;;
	esac

	json_init
	json_add_string action probe
	json_add_boolean installed "$installed"
	json_add_boolean busy "$busy"
	json_add_string state "$(btopt_state)"
	json_add_string message "$(btopt_msg)"
	json_add_string kernel "$kver"
	json_add_string want_kernel "$BT_OPT_KVER"
	json_add_boolean kernel_ok "$([ "$kver" = "$BT_OPT_KVER" ] && echo 1 || echo 0)"
	json_add_boolean hci_present "$([ -d /sys/class/bluetooth ] || [ -e /dev/ttyBT0 ] && echo 1 || echo 0)"
	json_add_string version "$BT_OPT_TAG"
	json_add_string file "$BT_OPT_FILE"
	json_add_string url "https://github.com/shangjie1998/airsim-f50-openwrt/releases/download/$BT_OPT_TAG/$BT_OPT_FILE"
	json_add_string label '蓝牙（可选配件）'
	json_dump
}

btopt_install() {
	if [ ! -x "$BT_OPT_RUN" ]; then
		json_init
		json_add_boolean ok 0
		json_add_string error '本机没有安装器（主包版本太旧）'
		json_dump
		return 0
	fi
	case "$(btopt_state)" in
		download|verify|extract|install)
			json_init
			json_add_boolean ok 0
			json_add_string error '正在装，等这次的就好'
			json_dump
			return 0
			;;
	esac
	mkdir -p "$BT_OPT_DIR"
	rm -f "$BT_OPT_DIR/state" "$BT_OPT_DIR/msg"
	nohup sh "$BT_OPT_RUN" >/dev/null 2>&1 &
	json_init
	json_add_boolean ok 1
	json_add_string state 'download'
	json_dump
}

# ---- 删除已配对设备 ----------------------------------------------------------
# BlueZ 把每台配对设备装成 /var/lib/bluetooth/<控制器>/<mac>/info。
# 正规做法是走 bluetoothctl remove（bluetoothd 会同步内存里的设备表）；
# bluetoothctl 不灵或没装时，退回删目录 + 重启 bluetoothd，再把可见性复位 ——
# 不然删完 PSCAN/ISCAN 会掉，手机就搜不到了。
bt_ctrl_addr() {
	_a=$(cat "$HCI/address" 2>/dev/null | tr -d '\n')
	if [ -z "$_a" ] && command -v hciconfig >/dev/null 2>&1; then
		_a=$(hciconfig hci0 2>/dev/null | sed -n 's/.*BD Address: *\([0-9A-Fa-f:]*\).*/\1/p' | head -n 1)
	fi
	printf '%s' "$_a" | tr 'a-f' 'A-F'
}

bt_rescan() {
	[ -d "$HCI" ] || return 0
	if command -v hciconfig >/dev/null 2>&1; then hciconfig hci0 piscan >/dev/null 2>&1; fi
	if command -v bluetoothctl >/dev/null 2>&1; then
		printf 'pairable on\ndiscoverable on\nquit\n' | bluetoothctl >/dev/null 2>&1
	fi
}

bt_unpair() {
	IFS= read -r request
	a=
	if json_load "$request" 2>/dev/null; then
		json_get_var a address 2>/dev/null
	fi
	a=$(printf '%s' "$a" | tr 'a-f' 'A-F')

	if ! printf '%s' "$a" | grep -qE '^([0-9A-F]{2}:){5}[0-9A-F]{2}$'; then
		json_init
		json_add_boolean ok 0
		json_add_string error '地址格式不对'
		json_dump
		return 0
	fi

	ctrl=$(bt_ctrl_addr)
	[ -n "$ctrl" ] || ctrl=$(ls /var/lib/bluetooth 2>/dev/null | head -n 1)

	# 已连接的要先断开，不然 remove 会留个半截
	if command -v hcitool >/dev/null 2>&1 && hcitool con 2>/dev/null | grep -qi "$a"; then
		if command -v bluetoothctl >/dev/null 2>&1; then
			printf 'disconnect %s\nquit\n' "$a" | bluetoothctl >/dev/null 2>&1
		else
			hcitool cmd 0x01 0x0406 >/dev/null 2>&1
		fi
		sleep 1
	fi

	gone=0
	if command -v bluetoothctl >/dev/null 2>&1; then
		out=$(printf 'remove %s\nquit\n' "$a" | bluetoothctl 2>&1)
		printf '%s' "$out" | grep -qiE 'Device has been removed|removed|not available' && gone=1
	fi

	# 兜底：直接删存储目录（bluetoothctl 不在或没删掉时）
	if [ -n "$ctrl" ] && [ -d "/var/lib/bluetooth/$ctrl/$a" ]; then
		rm -rf "/var/lib/bluetooth/$ctrl/$a" && gone=1
		[ -x /etc/init.d/bluetoothd ] && /etc/init.d/bluetoothd restart >/dev/null 2>&1
		sleep 2
	fi
	bt_rescan

	json_init
	if [ "$gone" = 1 ]; then
		json_add_boolean ok 1
		json_add_boolean removed 1
		json_add_string address "$a"
		json_add_string message '已删除，对方下次连接需要重新配对'
	else
		json_add_boolean ok 0
		json_add_boolean removed 0
		json_add_string address "$a"
		json_add_string error '没删掉：设备记录不在，或蓝牙服务没响应'
	fi
	json_dump
}

case "$1" in
	list)
		printf '%s\n' '{"bt_get":{},"bt_set":{"enable":"Boolean"},"bt_unpair":{"address":"String"},"bt_opt_probe":{},"bt_opt_install":{}}'
		;;
	call)
		case "$2" in
		bt_get) bt_state ;;
		bt_set) bt_set ;;
		bt_unpair) bt_unpair ;;
		bt_opt_probe) btopt_probe ;;
		bt_opt_install) btopt_install ;;
		*) exit 1 ;;
		esac
		;;
	*)
		exit 1
		;;
esac
