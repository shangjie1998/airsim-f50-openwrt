#!/bin/sh
# AirSIM for F50 —— 蓝牙开关（独立 rpcd 对象 airsim-bt）
#
# 只做一件事：把 /usr/sbin/f50-bt-switch.sh（on/off/status）包成 ubus 方法，
# 让 LuCI 页面不必走 fs.exec 白名单。开关状态持久化在 /etc/config/f50-bt，
# 值为 0 时开机脚本直接跳过拉起 —— 即「关了以后重启仍然是关」。
#
# 返回字段与 M8 的 airsim-bt 对齐（supported/enabled/attached/address/adapter/
# up/bluetoothd/service/label），这样页面可以两端共用一份。
#
# 与上游的关系：不改上游任何文件，ubus 上多一个 airsim-bt 对象。

. /usr/share/libubox/jshn.sh

SW=/usr/sbin/f50-bt-switch.sh
CONF=/etc/config/f50-bt
HCI=/sys/class/bluetooth/hci0

# 可选件（bt-opt）：固定 tag，跟主包版本解耦；内核不固定 —— 配件包里是编译好的 .ko，
# 每个内核出一份，装错内核等于把蓝牙装死。所以这里只记版本号，内核按 uname -r 现算。
BT_OPT_TAG=bt-opt-v1.0.3
BT_OPT_VER=1.0.3
# 出过包的内核清单：页面拿它跟当前内核比对，对不上就提示「内核不匹配」而不是硬装。
# 新出的包也会从 Release 检查结果和本地缓存里自动补进来，见 bt_opt_avail_krels。
BT_OPT_KERNELS='6.18.60 7.3.1'
BT_OPT_DIR=/tmp/airsim-btopt
BT_OPT_RUN=/usr/libexec/airsim-btopt-install

bt_state() {
	en=$(uci -q get f50-bt.settings.enabled 2>/dev/null)
	[ -n "$en" ] || en=unset

	# 配件链路是否闭合：bluetoothd/btattach 不少固件本来就自带，光看它们会误报可用。
	# 必须有服务脚本和挂控制器的脚本，链路才走得通。
	chain_ok=0
	if [ -x /usr/bin/bluetoothd ] && [ -x /usr/bin/btattach ] \
	   && [ -x /usr/sbin/sprd-bt-attach.sh ] && [ -x /etc/init.d/sprdbluetooth ]; then
		chain_ok=1
	fi
	# 原生驱动自带、控制器已经在，也算能用（7.3.1 这类镜像就是这情况）。
	# 注意这只补"固件没脚本但硬件能用"，不能拿它当"配件装没装"的依据：
	# 开关一关 hci0 就没了，用它兜底会让 supported 跟着开关一起翻，页面就整块消失了。
	[ -d "$HCI" ] && chain_ok=1

	json_init
	json_add_boolean supported "$chain_ok"
	json_add_string label '蓝牙'
	json_add_string service 'sprdbluetooth'
	json_add_string adapter 'hci0'

	if [ "$en" = 1 ]; then json_add_boolean enabled 1; else json_add_boolean enabled 0; fi

	if [ -d "$HCI" ]; then
		json_add_boolean attached 1
	else
		json_add_boolean attached 0
	fi

	# 这个 6.18 内核的 /sys/class/bluetooth/hci0 下没有 address 节点，
	# 地址只能从 hciconfig 的 BD Address 里取；两处都试一次。
	# 注意：没有 hci0 的时候别去碰 hciconfig/bluetoothctl —— 后者等 D-Bus 能等满 30 秒，
	# ubus 那边就表现为「整页卡住」。
	addr=
	if [ -d "$HCI" ]; then
		addr=$(cat "$HCI/address" 2>/dev/null | tr -d '\n')
		if [ -z "$addr" ] && command -v hciconfig >/dev/null 2>&1; then
			addr=$(hciconfig hci0 2>/dev/null | sed -n 's/.*BD Address: *\([0-9A-Fa-f:]*\).*/\1/p' | head -n 1)
		fi
	fi
	[ -n "$addr" ] && json_add_string address "$addr"

	up=0
	if [ -d "$HCI" ]; then
		if command -v hciconfig >/dev/null 2>&1; then
			hciconfig hci0 2>/dev/null | grep -qi 'UP RUNNING' && up=1
		else
			up=1
		fi
	fi
	json_add_boolean up "$up"

	bluetoothd=0
	pgrep -f '[b]luetoothd' >/dev/null 2>&1 && bluetoothd=1
	json_add_boolean bluetoothd "$bluetoothd"

	# 显示名：手机蓝牙列表里看到的就是它（attach 脚本算的 F50-<地址后6位>）
	# hciconfig 不带 -a 不打印名字，必须 -a；手机端看到的是这个名字
	nm=
	if [ -d "$HCI" ]; then
		nm=$(hciconfig -a hci0 2>/dev/null | sed -n "s/.*Name: *'\(.*\)'.*/\1/p" | head -n 1)
		# hciconfig 读本地名偶尔会 HCI 超时（尤其刚重启 bluetoothd 之后），
		# 这时退回 bluetoothctl：它读的是 bluetoothd 的 alias。但 bluetoothctl 在
		# 没有 bluetoothd 时会死等 D-Bus，所以必须先确认 bluetoothd 在跑，再套 timeout。
		if [ -z "$nm" ] && [ "$bluetoothd" = 1 ] && command -v bluetoothctl >/dev/null 2>&1; then
			nm=$(timeout 3 bluetoothctl show 2>/dev/null | sed -n 's/^[[:space:]]*Name:[[:space:]]*//p' | head -n 1)
		fi
	fi
	[ -n "$nm" ] && json_add_string name "$nm"

	# 可见性：PSCAN=可被发现，ISCAN=可被连接。默认开机就打开，见 airsim-bt-boot。
	discoverable=0
	pairable=0
	if [ -d "$HCI" ] && command -v hciconfig >/dev/null 2>&1; then
		hciconfig hci0 2>/dev/null | grep -q 'PSCAN' && discoverable=1
		hciconfig hci0 2>/dev/null | grep -q 'ISCAN' && pairable=1
	fi
	json_add_boolean discoverable "$discoverable"
	json_add_boolean pairable "$pairable"

	# 已配对设备：BlueZ 每台配对设备存成 /var/lib/bluetooth/<控制器>/<mac>/info，
	# 只有带 [LinkKey] 段的才算真配对。先落临时文件再读，别让 jshn 掉进管道子 shell。
	json_add_array devices
	if [ -n "$addr" ] && [ -d "/var/lib/bluetooth/$addr" ]; then
		_tmp=$(mktemp /tmp/airsim-bt-dev.XXXXXX 2>/dev/null || echo /tmp/airsim-bt-dev.$$)
		_con=$(hcitool con 2>/dev/null)
		for _d in /var/lib/bluetooth/"$addr"/*; do
			[ -d "$_d" ] || continue
			_ma=$(basename "$_d")
			case "$_ma" in cache|settings) continue ;; esac
			_info="$_d/info"
			[ -f "$_info" ] || continue
			grep -q '^\[LinkKey\]' "$_info" 2>/dev/null || continue
			_n=$(sed -n 's/^Name=/ /p' "$_info" 2>/dev/null | head -n 1 | sed 's/^ //')
			_cn=0
			printf '%s' "$_con" | grep -qi "$_ma" && _cn=1
			printf '%s\t%s\t%s\n' "$_ma" "${_n:-未命名}" "$_cn" >> "$_tmp"
		done
		while IFS='	' read -r _a _n _c; do
			[ -n "$_a" ] || continue
			json_add_object
			json_add_string address "$_a"
			json_add_string name "$_n"
			json_add_boolean connected "$_c"
			json_close_object
		done < "$_tmp"
		rm -f "$_tmp"
	fi
	json_close_array

	# 文案要跟着真实状态走：开关记着「开」但 hci0 不存在时，
	# 不能哄人说「可以直接搜到」——那正是页面显示"未挂载"却没人知道原因的那次。
	case "$en" in
	1)
		if [ -d "$HCI" ]; then
			json_add_string hint '控制器已挂载并保持可被发现；手机、耳机可以直接搜到这台设备。'
		else
			json_add_string hint '开关是开的，但控制器还没挂上；稍等十几秒，仍不行就关一次再打开（或重启后由开机脚本重试）。'
		fi
		;;
	unset) json_add_string hint '还没有写过开关配置，按默认（开）处理。' ;;
	*) json_add_string hint '已关闭；打开后控制器才挂载。' ;;
	esac
	json_dump
}

bt_set() {
	IFS= read -r request
	enable=0
	if json_load "$request" 2>/dev/null; then
		json_get_var enable enable 2>/dev/null
	fi
	case "$enable" in
	1|true|on|yes) want=on ;;
	*) want=off ;;
	esac
	if [ ! -x "$SW" ]; then
		json_init
		json_add_boolean ok 0
		json_add_string error '蓝牙脚本不在位（/usr/sbin/f50-bt-switch.sh）'
		json_dump
		return
	fi
	out=$("$SW" "$want" 2>&1)
	# 开关动作顺便把可见性复位：sprdbluetooth 重启后会清掉 PSCAN/ISCAN，
	# 只写 hciconfig 不够，bluetoothd 那边也要 pairable/discoverable 打开。
	if [ "$want" = on ] && [ -d "$HCI" ]; then
		hciconfig hci0 piscan >/dev/null 2>&1
		if command -v bluetoothctl >/dev/null 2>&1; then
			printf 'pairable on\ndiscoverable on\nquit\n' | bluetoothctl >/dev/null 2>&1
		fi
	fi

	json_init
	json_add_boolean ok 1
	json_add_boolean supported 1
	json_add_string label '蓝牙'
	json_add_string service 'sprdbluetooth'
	json_add_string adapter 'hci0'
	if [ "$want" = on ]; then json_add_boolean enabled 1; else json_add_boolean enabled 0; fi
	if [ -d "$HCI" ]; then json_add_boolean attached 1; else json_add_boolean attached 0; fi
	# 这个 6.18 内核的 /sys/class/bluetooth/hci0 下没有 address 节点，
	# 地址只能从 hciconfig 的 BD Address 里取；两处都试一次。
	addr=$(cat "$HCI/address" 2>/dev/null | tr -d '\n')
	if [ -z "$addr" ] && command -v hciconfig >/dev/null 2>&1; then
		addr=$(hciconfig hci0 2>/dev/null | sed -n 's/.*BD Address: *\([0-9A-Fa-f:]*\).*/\1/p' | head -n 1)
	fi
	[ -n "$addr" ] && json_add_string address "$addr"
	up=0
	if command -v hciconfig >/dev/null 2>&1; then
		hciconfig hci0 2>/dev/null | grep -qi 'UP RUNNING' && up=1
	else
		[ -d "$HCI" ] && up=1
	fi
	json_add_boolean up "$up"
	bluetoothd=0
	pgrep -f '[b]luetoothd' >/dev/null 2>&1 && bluetoothd=1
	json_add_boolean bluetoothd "$bluetoothd"
	json_add_string output "$out"
	json_dump
}

# ---- 可选件：探测 / 安装 ----------------------------------------------------
# 主包不带蓝牙那一套。没装过的机器用这两个方法把可选件装回来。
btopt_state() { cat "$BT_OPT_DIR/state" 2>/dev/null | head -1; }
btopt_msg() { cat "$BT_OPT_DIR/msg" 2>/dev/null | head -1; }

# 现有配件包覆盖哪些内核：已知清单 + Release 检查结果里记的文件名 + 本地躺着的包。
# 用途是给出「为什么装不上」的准确答案，而不是笼统说一句版本不对。
bt_opt_avail_krels() {
	_l=$BT_OPT_KERNELS
	_c=/usr/lib/airsim/opt-latest-bt-opt
	if [ -f "$_c" ]; then
		_f=$(. "$_c" 2>/dev/null; printf '%s' "${file:-}")
		case "$_f" in
			*-k*.tar.gz)
				_k=${_f##*-k}
				_l="$_l ${_k%.tar.gz}"
				;;
		esac
	fi
	for _p in /mnt/mu300-disk/extra/airsim-bt-opt-*.tar.gz; do
		[ -f "$_p" ] || continue
		_k=${_p##*-k}
		_l="$_l ${_k%.tar.gz}"
	done
	printf '%s\n' $_l | sort -u | tr '\n' ' '
}

btopt_probe() {
	kver=$(uname -r)
	# 当前内核是否自带蓝牙驱动：7.3.1 这类镜像自带 wcn_bsp/sprdbt_tty，
	# 不需要 bt-opt 配件包（那份 .ko 是按 6.18.60 编的，别混用）。
	# 光看文件存不存在不够：切过内核以后，目录里可能躺的是别的内核编的残留。
	# 有 modinfo 就把 vermagic 一起核对，必须正好是当前内核那一版。
	native_bt=1
	for m in wcn_bsp sprdbt_tty; do
		f="/lib/modules/$kver/$m.ko"
		if [ ! -f "$f" ]; then
			native_bt=0
			continue
		fi
		if command -v modinfo >/dev/null 2>&1; then
			# modinfo 的 "vermagic:" 后面是 tab，先归一化再取第二个字段
			v=$(modinfo "$f" 2>/dev/null | tr '\t' ' ' | awk '/^vermagic:/{print $2; exit}')
			case "$v" in
				"$kver"|"$kver "*) ;;
				*) native_bt=0 ;;
			esac
		fi
	done
	# 「配件已装」要按整条链判定，不能只看两个客户端二进制 —— bluetoothd/btattach
	# 有些固件本来就自带，光凭它们存在就说「已安装」，页面会骗人去点扫描，实际扫不出东西。
	# 必须有服务脚本和 attach 脚本，链路才算闭合。
	installed=0
	if [ -x /usr/bin/bluetoothd ] && [ -x /usr/bin/btattach ] \
	   && [ -x /usr/sbin/sprd-bt-attach.sh ] && [ -x /etc/init.d/sprdbluetooth ]; then
		installed=1
	fi
	[ "$native_bt" = 1 ] && [ -d /sys/class/bluetooth/hci0 ] && installed=1

	busy=0
	case "$(btopt_state)" in
		download|verify|extract|install) busy=1 ;;
	esac

	avail=$(bt_opt_avail_krels)
	# 只问一件事：有没有对着这个内核编的配件包。别掺 native_bt ——
	# 驱动自带只说明「不装也行」，不等于「这个内核的包存在」，两码事。
	kernel_ok=0
	case " $avail " in *" $kver "*) kernel_ok=1 ;; esac
	opt_file="airsim-f50-bt-opt-$BT_OPT_VER-k$kver.tar.gz"

	json_init
	json_add_string action probe
	json_add_boolean installed "$installed"
	json_add_boolean busy "$busy"
	json_add_string state "$(btopt_state)"
	json_add_string message "$(btopt_msg)"
	json_add_string kernel "$kver"
	json_add_string want_kernel "$(printf '%s' "$avail" | sed 's/^ *//; s/ *$//')"
	json_add_boolean native_bt "$native_bt"
	json_add_boolean kernel_ok "$kernel_ok"
	json_add_boolean hci_present "$([ -d /sys/class/bluetooth ] || [ -e /dev/ttyBT0 ] && echo 1 || echo 0)"
	json_add_string version "$BT_OPT_TAG"
	json_add_string file "$opt_file"
	json_add_string url "https://github.com/shangjie1998/airsim-f50-openwrt/releases/download/$BT_OPT_TAG/$opt_file"
	json_add_string label '蓝牙（可选配件）'
	json_dump
}

# 读"检查更新"留下的缓存，把查到的最新 tag/ver/file 带出来（本身不联网）
# 输出到 OPT_NEW_TAG / OPT_NEW_VER / OPT_NEW_FILE，缓存不存在或不可用时三者全空
opt_override() {
	OPT_NEW_TAG=; OPT_NEW_VER=; OPT_NEW_FILE=
	_c=/usr/lib/airsim/opt-latest-$1
	[ -f "$_c" ] || return 0
	_val=$(
		. "$_c" 2>/dev/null
		[ "${ok:-0}" = 1 ] || exit 0
		[ -n "${tag:-}" ] || exit 0
		printf '%s|%s|%s' "${tag}" "${ver:-}" "${file:-}"
	)
	[ -n "$_val" ] || return 0
	OPT_NEW_TAG=${_val%%|*}
	_val=${_val#*|}
	OPT_NEW_VER=${_val%%|*}
	OPT_NEW_FILE=${_val#*|}
}

btopt_install() {
	if [ ! -x "$BT_OPT_RUN" ]; then
		json_init
		json_add_boolean ok 0
		json_add_string error '本机没有安装器（主包版本太旧）'
		json_dump
		return 0
	fi
	case "$(btopt_state)" in
		download|verify|extract|install)
			json_init
			json_add_boolean ok 0
			json_add_string error '正在装，等这次的就好'
			json_dump
			return 0
			;;
	esac
	# 配件包里是编好的 .ko，跟内核版本绑死。本机内核不在覆盖范围内就直说，不硬装。
	kver=$(uname -r)
	avail=$(bt_opt_avail_krels)
	case " $avail " in
		*" $kver "*) ;;
		*)
			json_init
			json_add_boolean ok 0
			json_add_string error "本机内核 $kver，现有配件包只对 $(printf '%s' "$avail" | sed 's/^ *//; s/ *$//') 出过；驱动对不上，硬装只会把蓝牙装死。等这个内核的包出来，或者把系统切到上面列出的内核。"
			json_dump
			return 0
			;;
	esac
	# 检查更新查到了更新的配件包，就让这次安装直接去拉新版（缓存里没有就按内核算文件名）
	opt_override bt-opt
	BT_LATEST_TAG=$BT_OPT_TAG
	BT_LATEST_FILE="airsim-f50-bt-opt-$BT_OPT_VER-k$kver.tar.gz"
	if [ -n "$OPT_NEW_TAG" ] && ver_gt "$OPT_NEW_VER" "${BT_OPT_TAG#bt-opt-v}"; then
		BT_LATEST_TAG=$OPT_NEW_TAG
		BT_LATEST_FILE=$OPT_NEW_FILE
	fi
	mkdir -p "$BT_OPT_DIR"
	rm -f "$BT_OPT_DIR/state" "$BT_OPT_DIR/msg"
	# rpcd 是 procd 管的：ubus 这次调用一结束，nohup & 起的子进程会被一起收掉，
	# 页面点了「安装」就永远卡在 download、连日志都留不下。setsid 另开会话才活得下来。
	AIRSIM_OPT_TAG=$BT_LATEST_TAG AIRSIM_OPT_FILE=$BT_LATEST_FILE \
		setsid sh "$BT_OPT_RUN" >/dev/null 2>&1 &
	json_init
	json_add_boolean ok 1
	json_add_string state 'download'
	json_dump
}

# ---- 删除已配对设备 ----------------------------------------------------------
# BlueZ 把每台配对设备装成 /var/lib/bluetooth/<控制器>/<mac>/info。
# 正规做法是走 bluetoothctl remove（bluetoothd 会同步内存里的设备表）；
# bluetoothctl 不灵或没装时，退回删目录 + 重启 bluetoothd，再把可见性复位 ——
# 不然删完 PSCAN/ISCAN 会掉，手机就搜不到了。
bt_ctrl_addr() {
	_a=$(cat "$HCI/address" 2>/dev/null | tr -d '\n')
	if [ -z "$_a" ] && command -v hciconfig >/dev/null 2>&1; then
		_a=$(hciconfig hci0 2>/dev/null | sed -n 's/.*BD Address: *\([0-9A-Fa-f:]*\).*/\1/p' | head -n 1)
	fi
	printf '%s' "$_a" | tr 'a-f' 'A-F'
}

bt_rescan() {
	[ -d "$HCI" ] || return 0
	if command -v hciconfig >/dev/null 2>&1; then hciconfig hci0 piscan >/dev/null 2>&1; fi
	if command -v bluetoothctl >/dev/null 2>&1; then
		printf 'pairable on\ndiscoverable on\nquit\n' | bluetoothctl >/dev/null 2>&1
	fi
}

bt_unpair() {
	IFS= read -r request
	a=
	if json_load "$request" 2>/dev/null; then
		json_get_var a address 2>/dev/null
	fi
	a=$(printf '%s' "$a" | tr 'a-f' 'A-F')

	if ! printf '%s' "$a" | grep -qE '^([0-9A-F]{2}:){5}[0-9A-F]{2}$'; then
		json_init
		json_add_boolean ok 0
		json_add_string error '地址格式不对'
		json_dump
		return 0
	fi

	ctrl=$(bt_ctrl_addr)
	[ -n "$ctrl" ] || ctrl=$(ls /var/lib/bluetooth 2>/dev/null | head -n 1)

	# 已连接的要先断开，不然 remove 会留个半截
	if command -v hcitool >/dev/null 2>&1 && hcitool con 2>/dev/null | grep -qi "$a"; then
		if command -v bluetoothctl >/dev/null 2>&1; then
			printf 'disconnect %s\nquit\n' "$a" | bluetoothctl >/dev/null 2>&1
		else
			hcitool cmd 0x01 0x0406 >/dev/null 2>&1
		fi
		sleep 1
	fi

	gone=0
	if command -v bluetoothctl >/dev/null 2>&1; then
		out=$(printf 'remove %s\nquit\n' "$a" | bluetoothctl 2>&1)
		printf '%s' "$out" | grep -qiE 'Device has been removed|removed|not available' && gone=1
	fi

	# 兜底：直接删存储目录（bluetoothctl 不在或没删掉时）
	if [ -n "$ctrl" ] && [ -d "/var/lib/bluetooth/$ctrl/$a" ]; then
		rm -rf "/var/lib/bluetooth/$ctrl/$a" && gone=1
		[ -x /etc/init.d/bluetoothd ] && /etc/init.d/bluetoothd restart >/dev/null 2>&1
		sleep 2
	fi
	bt_rescan

	json_init
	if [ "$gone" = 1 ]; then
		json_add_boolean ok 1
		json_add_boolean removed 1
		json_add_string address "$a"
		json_add_string message '已删除，对方下次连接需要重新配对'
	else
		json_add_boolean ok 0
		json_add_boolean removed 0
		json_add_string address "$a"
		json_add_string error '没删掉：设备记录不在，或蓝牙服务没响应'
	fi
	json_dump
}

# ---- 附近设备 / 主动配对 / 被动请求应答 -------------------------------------
# 真正干活的是一个常驻的 bluetoothctl（/usr/libexec/airsim-bt-agent，python3
# 驱动 pty）。rpcd 这边只负责：把它拉起来、往 FIFO 里下命令、读它写的文件。
AGT_DIR=/tmp/airsim-bt-agent
AGT_RUN=/usr/libexec/airsim-bt-agent

agt_ensure() {
	mkdir -p "$AGT_DIR"
	[ -p "$AGT_DIR/cmd" ] || mkfifo "$AGT_DIR/cmd" 2>/dev/null
	# 心跳 5 秒没动 = 假活（脚本进程还在，但它里头的 bluetoothctl 已经没了），
	# 这种时候往 FIFO 里写命令是有去无回，所以直接杀掉重起
	if pgrep -f '[a]irsim-bt-agent' >/dev/null 2>&1; then
		_now=$(date +%s)
		_hb=0
		[ -f "$AGT_DIR/heartbeat" ] && _hb=$(cat "$AGT_DIR/heartbeat" 2>/dev/null)
		case "${_hb:-0}" in ''|*[!0-9]*) _hb=0 ;; esac
		if [ $((_now - _hb)) -le 5 ]; then return 0; fi
		kill $(pgrep -f '[a]irsim-bt-agent') 2>/dev/null
		kill $(pgrep -x bluetoothctl) 2>/dev/null
		rm -rf "$AGT_DIR"
		mkdir -p "$AGT_DIR"
		mkfifo "$AGT_DIR/cmd" 2>/dev/null
	fi
	[ -x "$AGT_RUN" ] || return 1
	# 设备上的 start-stop-daemon 是 busybox 版，不认 -- python3 -- script 这种
	# 带参数的形式（实测 rc=1 直接起不来）。它认 -x script，脚本本身有 shebang，
	# 所以最稳的是直接后台跑，别指望它。
	"$AGT_RUN" >/dev/null 2>&1 &
	# 等它就绪再回去。以前这里只 sleep 1：进程是起来了，但它里面的 python
	# 还要开 pty、拉 bluetoothctl、连 D-Bus、注册配对 agent，开机后这段远不止 1 秒。
	# scan_on 正好落进这个空档就白发了 —— 表现出来就是「重启后第一次扫描扫不出东西，
	# 关一下再开就好了」。agent 是在主循环里写心跳的，心跳变新鲜 = 真能接命令了。
	_w=0
	while [ "$_w" -lt 12 ]; do
		_now=$(date +%s)
		_hb=0
		[ -f "$AGT_DIR/heartbeat" ] && _hb=$(cat "$AGT_DIR/heartbeat" 2>/dev/null)
		case "${_hb:-0}" in ''|*[!0-9]*) _hb=0 ;; esac
		[ $((_now - _hb)) -le 3 ] && break
		sleep 1
		_w=$((_w + 1))
	done
	pgrep -f '[a]irsim-bt-agent' >/dev/null 2>&1
}

agt_send() {
	agt_ensure || return 1
	# FIFO 没有读端时直接 printf > fifo 会一直阻塞，ubus 那边就是 30 秒超时。
	# 用读写方式打开（3<>）拿到两端，写完立刻关，不会卡。
	( exec 3<> "$AGT_DIR/cmd" 2>/dev/null && printf '%s\n' "$1" >&3 ) 2>/dev/null
}

bt_nearby() {
	agt_ensure >/dev/null 2>&1
	ctrl=$(bt_ctrl_addr)
	_con=$(hcitool con 2>/dev/null)
	json_init
	json_add_array nearby
	# agent 每扫到一台就往 devices.tsv 写一行「地址<TAB>名字」，shell 直接按行读
	if [ -s "$AGT_DIR/devices.tsv" ]; then
		_now=$(date +%s)
		while IFS='	' read -r _a _n _ts; do
			[ -n "$_a" ] || continue
			# 只留 3 分钟内见过的，免得把很久以前的残留设备当"附近"
			case "${_ts:-0}" in ''|*[!0-9]*) _ts=0 ;; esac
			[ "$_ts" -gt 0 ] && [ $((_now - _ts)) -gt 180 ] && continue
			_a=$(printf '%s' "$_a" | tr 'a-f' 'A-F')
			_p=0
			[ -n "$ctrl" ] && [ -d "/var/lib/bluetooth/$ctrl/$_a" ] && _p=1
			_c=0
			printf '%s' "$_con" | grep -qi "$_a" && _c=1
			json_add_object
			json_add_string address "$_a"
			json_add_string name "${_n:-未知设备}"
			json_add_boolean paired "$_p"
			json_add_boolean connected "$_c"
			json_close_object
		done < "$AGT_DIR/devices.tsv"
	fi
	json_close_array
	json_dump
}

bt_scan() {
	IFS= read -r request
	want=on
	if json_load "$request" 2>/dev/null; then
		json_get_var want on 2>/dev/null
	fi
	case "$want" in
	off|0|false|no)
		agt_send scan_off >/dev/null 2>&1
		json_init; json_add_boolean ok 1; json_add_boolean scanning 0; json_dump
		return 0
		;;
	esac
	# 开关没开就别假装在扫：控制器都不在，扫也扫不出东西，页面还会一直显示「扫描中」骗人
	[ -d "$HCI" ] || {
		json_init; json_add_boolean ok 0
		json_add_string error '蓝牙开关没开。先把开关打开，等控制器挂上再扫。'
		json_dump
		return 0
	}
	if ! agt_send scan_on; then
		json_init; json_add_boolean ok 0
		json_add_string error '蓝牙执行器没起来（机器上缺 python3 或 agent 脚本）'
		json_dump
		return 0
	fi
	# 15 秒后自动停，省得一直扫着费电
	( sleep 15; ( exec 3<> "$AGT_DIR/cmd" && printf 'scan_off\n' >&3 ) ) >/dev/null 2>&1 &
	json_init
	json_add_boolean ok 1
	json_add_boolean scanning 1
	json_add_int seconds 15
	json_dump
}

bt_pair() {
	IFS= read -r request
	a=
	if json_load "$request" 2>/dev/null; then json_get_var a address 2>/dev/null; fi
	a=$(printf '%s' "$a" | tr 'a-f' 'A-F')
	if ! printf '%s' "$a" | grep -qE '^([0-9A-F]{2}:){5}[0-9A-F]{2}$'; then
		json_init; json_add_boolean ok 0; json_add_string error '地址格式不对'; json_dump; return 0
	fi
	if ! agt_send "pair $a"; then
		json_init; json_add_boolean ok 0; json_add_string error '蓝牙执行器没起来'; json_dump; return 0
	fi
	json_init
	json_add_boolean ok 1
	json_add_string address "$a"
	json_add_string message '已发起配对，等对方确认（30 秒内没反应就算失败）'
	json_dump
}

bt_connect() {
	IFS= read -r request
	a=
	if json_load "$request" 2>/dev/null; then json_get_var a address 2>/dev/null; fi
	a=$(printf '%s' "$a" | tr 'a-f' 'A-F')
	if ! printf '%s' "$a" | grep -qE '^([0-9A-F]{2}:){5}[0-9A-F]{2}$'; then
		json_init; json_add_boolean ok 0; json_add_string error '地址格式不对'; json_dump; return 0
	fi
	if ! agt_send "connect $a"; then
		json_init; json_add_boolean ok 0; json_add_string error '蓝牙执行器没起来'; json_dump; return 0
	fi
	json_init
	json_add_boolean ok 1
	json_add_string address "$a"
	json_add_string message '正在连接，稍等'
	json_dump
}

bt_action_result() {
	r="$AGT_DIR/result.json"
	json_init
	if [ -f "$r" ]; then
		ts=$(jsonfilter -i "$r" -e '@.ts' 2>/dev/null)
		act=$(jsonfilter -i "$r" -e '@.action' 2>/dev/null)
		ad=$(jsonfilter -i "$r" -e '@.address' 2>/dev/null)
		dn=$(jsonfilter -i "$r" -e '@.done' 2>/dev/null)
		ok=$(jsonfilter -i "$r" -e '@.ok' 2>/dev/null)
		ms=$(jsonfilter -i "$r" -e '@.message' 2>/dev/null)
		json_add_string action "${act:-}"
		json_add_string address "${ad:-}"
		json_add_boolean done "$([ "$dn" = true ] && echo 1 || echo 0)"
		json_add_boolean ok "$([ "$ok" = true ] && echo 1 || echo 0)"
		json_add_string message "${ms:-}"
		json_add_int ts "${ts:-0}"
	else
		json_add_string action ''
		json_add_boolean done 0
		json_add_int ts 0
	fi
	json_dump
}

bt_pair_pending() {
	p="$AGT_DIR/pending.json"
	json_init
	if [ -f "$p" ]; then
		ts=$(jsonfilter -i "$p" -e '@.ts' 2>/dev/null)
		ad=$(jsonfilter -i "$p" -e '@.address' 2>/dev/null)
		nm=$(jsonfilter -i "$p" -e '@.name' 2>/dev/null)
		kd=$(jsonfilter -i "$p" -e '@.kind' 2>/dev/null)
		lb=$(jsonfilter -i "$p" -e '@.label' 2>/dev/null)
		pk=$(jsonfilter -i "$p" -e '@.passkey' 2>/dev/null)
		an=$(jsonfilter -i "$p" -e '@.answered' 2>/dev/null)
		left=0
		case "${ts:-0}" in
		''|*[!0-9]*) ts=0 ;;
		esac
		now=$(date +%s)
		if [ "${ts:-0}" -gt 0 ]; then
			left=$((ts + 30 - now))
			[ "$left" -lt 0 ] && left=0
		fi
		if [ -n "$an" ] || [ "$left" = 0 ]; then
			json_add_boolean pending 0
		else
			json_add_boolean pending 1
		fi
		json_add_string address "${ad:-}"
		json_add_string name "${nm:-}"
		json_add_string kind "${kd:-}"
		json_add_string label "${lb:-}"
		json_add_string passkey "${pk:-}"
		json_add_int seconds_left "$left"
	else
		json_add_boolean pending 0
		json_add_int seconds_left 0
	fi
	json_dump
}

bt_pair_reply() {
	IFS= read -r request
	d=no
	if json_load "$request" 2>/dev/null; then json_get_var d decision 2>/dev/null; fi
	case "$d" in
	yes|1|true|ok) d=yes ;;
	*) d=no ;;
	esac
	mkdir -p "$AGT_DIR"
	printf '%s' "$d" > "$AGT_DIR/decision" 2>/dev/null
	json_init
	json_add_boolean ok 1
	json_add_string decision "$d"
	json_dump
}

ver_gt() {
	awk -v a="$1" -v b="$2" 'BEGIN{
		split(a, x, "."); split(b, y, ".")
		for (i = 1; i <= 3; i++) {
			if (x[i] + 0 > y[i] + 0) exit 0
			if (x[i] + 0 < y[i] + 0) exit 1
		}
		exit 1
	}'
}

# 蓝牙配件包"检查更新"：与音频共用 /usr/libexec/airsim-opt-latest，前缀换 bt-opt
bt_opt_latest() {
	_cur=${BT_OPT_TAG#bt-opt-v}
	
	# rpcd 的入参走环境变量（force=1 时忽略缓存强制联网）
	_f=''
	case "${force:-}" in 1|true|True|yes) _f=force ;; esac
	eval "$(sh /usr/libexec/airsim-opt-latest bt-opt $_f 2>/dev/null)" 2>/dev/null || :
	ok=${ok:-0}; tag=${tag:-}; ver=${ver:-}; file=${file:-}; checked_at=${checked_at:-0}
	cooldown=${cooldown:-0}; err=${err:-}; stale=${stale:-0}; cached=${cached:-0}
	_up=0
	[ -n "$ver" ] && ver_gt "$ver" "$_cur" && _up=1
	json_init
	json_add_boolean ok "$([ "$ok" = 1 ] && echo 1 || echo 0)"
	json_add_boolean has_update "$_up"
	json_add_string current_ver "$_cur"
	json_add_string latest_tag "$tag"
	json_add_string latest_ver "$ver"
	json_add_string latest_file "$file"
	json_add_string checked_at "$checked_at"
	json_add_boolean cooldown "$([ "$cooldown" = 1 ] && echo 1 || echo 0)"
	json_add_boolean stale "$([ "$stale" = 1 ] && echo 1 || echo 0)"
	json_add_boolean cached "$([ "$cached" = 1 ] && echo 1 || echo 0)"
	json_add_string error "$err"
	json_dump
}

case "$1" in
	list)
		printf '%s\n' '{"bt_get":{},"bt_set":{"enable":"Boolean"},"bt_unpair":{"address":"String"},"bt_nearby":{},"bt_scan":{"on":"String"},"bt_pair":{"address":"String"},"bt_connect":{"address":"String"},"bt_action_result":{},"bt_pair_pending":{},"bt_pair_reply":{"decision":"String"},"bt_opt_probe":{},"bt_opt_install":{},"bt_opt_latest":{}}'
		;;
	call)
		case "$2" in
		bt_get) bt_state ;;
		bt_set) bt_set ;;
		bt_unpair) bt_unpair ;;
		bt_nearby) bt_nearby ;;
		bt_scan) bt_scan ;;
		bt_pair) bt_pair ;;
		bt_connect) bt_connect ;;
		bt_action_result) bt_action_result ;;
		bt_pair_pending) bt_pair_pending ;;
		bt_pair_reply) bt_pair_reply ;;
		bt_opt_probe) btopt_probe ;;
		bt_opt_install) btopt_install ;;
		bt_opt_latest) bt_opt_latest ;;
		*) exit 1 ;;
		esac
		;;
	*)
		exit 1
		;;
esac
