#!/bin/sh
# AirSIM for F50 —— 短信薄封装（独立 rpcd 对象 airsim-sms）
#
# 目的：M8 的短信页/概览页调的是 airsim-sms（参数带 card），F50 的原生短信
# 接口是 mu300dash（参数带 slot，单卡）。这里做一层翻译，页面可以原样搬，
# 以后 M8 改页面不用重写。
#
# card → slot 映射：F50 只有一张卡，任何 card 值都落到默认槽位（不传即默认）。

. /usr/share/libubox/jshn.sh

DASH=mu300dash
AGENT=http://127.0.0.1:8575

# 「已读」是本地标记，不动 SIM 卡：
# mu300dash 只有 sms_list/show/send/sync/delete，没有标记已读的方法，
# 短信在卡上的 status 永远是 unread。所以这里自己记一份 id 清单，
# 列表返回前把它们改写成 read。放 /etc 下，重启和升级后都在。
READ_DB=/etc/airsim-sms-read

msg_is_read() {
	[ -n "$1" ] && grep -qx -- "$1" "$READ_DB" 2>/dev/null
}

msg_mark_read() {
	[ -n "$1" ] || return 0
	msg_is_read "$1" && return 0
	printf '%s\n' "$1" >> "$READ_DB" 2>/dev/null
}

req_get() {  # req_get <字段> [默认值]
	json_get_var _v "$1" 2>/dev/null
	printf '%s' "${_v:-${2:-}}"
	_v=''
}

forward_sms_list() {
	IFS= read -r request
	page=''
	if json_load "$request" 2>/dev/null; then page=$(req_get page); fi
	json_init
	[ -n "$page" ] && json_add_string page "$page"
	_q=$(json_dump)
	_raw=$(ubus call "$DASH" sms_list "$_q" 2>/dev/null)
	if [ -z "$_raw" ]; then printf '%s\n' '{"error":"设备短信服务未响应"}'; return; fi

	# 取字段一律用 jsonfilter：这台机器上 busybox 的 grep -o / sed 取 JSON 都不可靠。
	_total=$(printf '%s' "$_raw" | jsonfilter -e '@.total' 2>/dev/null)
	_page=$(printf '%s' "$_raw" | jsonfilter -e '@.page' 2>/dev/null)
	_pages=$(printf '%s' "$_raw" | jsonfilter -e '@.pages' 2>/dev/null)
	_used=$(printf '%s' "$_raw" | jsonfilter -e '@.sim_used' 2>/dev/null)
	_cap=$(printf '%s' "$_raw" | jsonfilter -e '@.sim_total' 2>/dev/null)
	_t=/tmp/.airsim-sms-$$
	printf '%s' "$_raw" | jsonfilter -e '@.msgs[*].id'      > "$_t.1" 2>/dev/null
	printf '%s' "$_raw" | jsonfilter -e '@.msgs[*].status'  > "$_t.2" 2>/dev/null
	printf '%s' "$_raw" | jsonfilter -e '@.msgs[*].dir'     > "$_t.3" 2>/dev/null
	printf '%s' "$_raw" | jsonfilter -e '@.msgs[*].peer'    > "$_t.4" 2>/dev/null
	printf '%s' "$_raw" | jsonfilter -e '@.msgs[*].time'    > "$_t.5" 2>/dev/null
	printf '%s' "$_raw" | jsonfilter -e '@.msgs[*].preview' > "$_t.6" 2>/dev/null
	_n=$(wc -l < "$_t.1" 2>/dev/null | tr -d ' ')

	# mu300dash 的 sim_used 是 0 基槽位号，转成人看的 SIM 名（F50 上恒为 SIM1）
	_simname="SIM$(( ${_used:-0} + 1 ))"
	json_init
	json_add_int total "${_total:-0}"
	json_add_int page "${_page:-1}"
	json_add_int pages "${_pages:-1}"
	json_add_int sim_used "${_used:-0}"
	json_add_int sim_total "${_cap:-0}"
	json_add_array msgs
	_unread=0
	i=1
	while [ "$i" -le "${_n:-0}" ]; do
		_mid=$(sed -n "${i}p" "$_t.1" 2>/dev/null)
		_mst=$(sed -n "${i}p" "$_t.2" 2>/dev/null)
		if [ -n "$_mid" ] && [ "$_mst" = unread ] && msg_is_read "$_mid"; then
			_mst=read
		fi
		if [ "$_mst" = unread ]; then _unread=$((_unread + 1)); fi
		json_add_object
		json_add_string id "$_mid"
		json_add_string status "${_mst:-read}"
		json_add_string dir "$(sed -n "${i}p" "$_t.3" 2>/dev/null)"
		json_add_string peer "$(sed -n "${i}p" "$_t.4" 2>/dev/null)"
		json_add_string time "$(sed -n "${i}p" "$_t.5" 2>/dev/null)"
		json_add_string preview "$(sed -n "${i}p" "$_t.6" 2>/dev/null)"
		# 页面拿 m.sim / m.card 判"来源"，两个都没有就显示"来源未知"。
		# mu300dash 只给 top 级 sim_used（0 基），这里换成 SIM1/SIM2 塞进每条。
		json_add_string sim "$_simname"
		json_close_object
		i=$((i + 1))
	done
	json_close_array
	json_add_int unread "$_unread"
	json_dump
	rm -f "$_t".[1-6]
}

forward_sms_show() {
	IFS= read -r request
	id=''
	slot=''
	if json_load "$request" 2>/dev/null; then id=$(req_get id); slot=$(req_get card); fi
	json_init
	[ -n "$id" ] && json_add_string id "$id"
	[ -n "$slot" ] && json_add_string slot "$slot"
	_out=$(ubus call "$DASH" sms_show "$(json_dump)" 2>/dev/null)
	printf '%s' "$_out"
	# 打开全文就当读过：记进本地清单，列表里立刻变"已读"。
	if [ -n "$id" ] && printf '%s' "$_out" | jsonfilter -e '@.ok' 2>/dev/null | grep -qx '1'; then
		msg_mark_read "$id"
	fi
}

forward_sms_send() {
	IFS= read -r request
	num='' text='' slot=''
	if json_load "$request" 2>/dev/null; then
		num=$(req_get num); text=$(req_get text); slot=$(req_get card)
	fi
	if [ -z "$num" ]; then printf '%s\n' '{"error":"缺少收件号码"}'; return; fi
	json_init
	json_add_string num "$num"
	json_add_string text "$text"
	[ -n "$slot" ] && json_add_string slot "$slot"
	ubus call "$DASH" sms_send "$(json_dump)" 2>/dev/null
}

forward_sms_job() {
	IFS= read -r request
	slot=''
	if json_load "$request" 2>/dev/null; then slot=$(req_get card); fi
	json_init
	[ -n "$slot" ] && json_add_string slot "$slot"
	ubus call "$DASH" sms_job "$(json_dump)" 2>/dev/null
}

# 单卡设备：直接报一张卡，字段名跟 M8 的页面保持一致
# 运营商名字：AT+COPS? 回的是 PLMN（46001 这种），F50 这条链上没有别的地方能给，
# 页面 SIM 标签和短信占位符 {operator} 都要它，所以这里现取现翻。
operator_name() {
	_plmn=$(mu300-at -t 3 'AT+COPS?' 2>/dev/null | sed -n 's/.*"\([0-9]\{5,6\}\)".*/\1/p' | head -n 1)
	case "$_plmn" in
	46000|46002|46007|46008) echo 中国移动 ;;
	46001|46006|46009) echo 中国联通 ;;
	46003|46005|46011) echo 中国电信 ;;
	46015) echo 中国广电 ;;
	*) echo '' ;;
	esac
}

sms_sims() {
	ins=false; num=''
	raw=$(curl -s -m 4 "$AGENT/api/status" 2>/dev/null)
	if [ -n "$raw" ]; then
		json_load "$raw" 2>/dev/null && {
			json_get_var ins sim_inserted
			json_get_var num phone_number
		}
	fi
	json_init
	# F50 单卡：卡槽号固定 0。页面拿 s.card 和 current 做数值比较，两边都得是数字，
	# 对不上就会被判成「未驻留 · 无实时测量」，所以这里用 json_add_int。
	json_add_int current 0
	json_add_array sims
	json_add_object
	json_add_string id '1'
	json_add_int card 0
	json_add_string name 'SIM 1'
	json_add_string number "$num"
	op=$(operator_name)
	json_add_string operator "$op"
	case "$ins" in
	1|true|yes) json_add_boolean present 1 ;;
	*) json_add_boolean present 0 ;;
	esac
	json_add_boolean data '1'
	json_close_object
	json_close_array
	json_dump
}

# 全部已读：逐页把 dash 的短信 id 收进本地清单，不碰 SIM 卡
mark_all_read() {
	_p=1
	_added=0
	while :; do
		_raw=$(ubus call "$DASH" sms_list "{\"page\":$_p}" 2>/dev/null)
		[ -n "$_raw" ] || break
		_pages=$(printf '%s' "$_raw" | jsonfilter -e '@.pages' 2>/dev/null)
		for _id in $(printf '%s' "$_raw" | jsonfilter -e '@.msgs[*].id' 2>/dev/null); do
			[ -n "$_id" ] || continue
			msg_is_read "$_id" && continue
			msg_mark_read "$_id"
			_added=$((_added + 1))
		done
		[ "$_p" -lt "${_pages:-1}" ] || break
		_p=$((_p + 1))
		[ "$_p" -gt 50 ] && break
	done
	printf '{"ok":1,"marked":%s}\n' "$_added"
}

# 清空：mu300dash 没有批量删接口（只有 sms_delete 删单条），
# 所以这里按页取 id、逐条删，删够 limit 就交回去让页面再点一轮。
do_clear_batch() {
	IFS= read -r request
	_limit=4
	if json_load "$request" 2>/dev/null; then
		_v=$(req_get limit)
		[ -n "$_v" ] && _limit=$_v
	fi
	_raw=$(ubus call "$DASH" sms_list '{"page":1}' 2>/dev/null)
	_deleted=0
	for _id in $(printf '%s' "$_raw" | jsonfilter -e '@.msgs[*].id' 2>/dev/null); do
		[ "$_deleted" -ge "$_limit" ] && break
		[ -n "$_id" ] || continue
		_ok=$(ubus call "$DASH" sms_delete "{\"id\":\"$_id\"}" 2>/dev/null | jsonfilter -e '@.ok' 2>/dev/null)
		[ "$_ok" = 1 ] || break
		_deleted=$((_deleted + 1))
		# 删掉的短信也把本地已读标记清掉，别让清单一直涨
		grep -vx -- "$_id" "$READ_DB" > "$READ_DB.tmp" 2>/dev/null && mv "$READ_DB.tmp" "$READ_DB" 2>/dev/null
	done
	_rem=$(ubus call "$DASH" sms_list '{"page":1}' 2>/dev/null | jsonfilter -e '@.total' 2>/dev/null)
	printf '{"ok":1,"deleted":%s,"remaining":%s}\n' "$_deleted" "${_rem:-0}"
}

case "$1" in
	list)
		printf '%s\n' '{"sms_list":{"page":"String","card":"String"},"sms_show":{"id":"String"},"sms_send":{"num":"String","text":"String","card":"String"},"sms_job":{"card":"String"},"sms_sims":{},"sms_read_all":{},"sms_clear_batch":{"limit":"String"}}'
		;;
	call)
		case "$2" in
		sms_list) forward_sms_list ;;
		sms_show) forward_sms_show ;;
		sms_send) forward_sms_send ;;
		sms_job) forward_sms_job ;;
		sms_sims) sms_sims ;;
		sms_read_all) mark_all_read ;;
		sms_clear_batch) do_clear_batch ;;
		*) exit 1 ;;
		esac
		;;
	*)
		exit 1
		;;
esac
