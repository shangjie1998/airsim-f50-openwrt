#!/bin/sh
# AirSIM for F50 —— 已配对客户端管理（独立 rpcd 对象 airsim-pair）
#
# 为什么要单独一个对象：上游 /usr/libexec/rpcd/airsim 没有 pair_clients /
# pair_remove 两个动作。往回改上游文件等于把上游整份占住，所以这里新起
# airsim-pair，页面改两行 rpc.declare 即可。
#
# 数据面：配对密钥存在 <data>/vowlan-clients.json（纯数组，一条一个 base64
# 密钥）。列表优先读 Go 守护进程 /pair/clients（给指纹 id、最近使用、活跃
# 状态）；移除由 Go 在网关准入锁内持久化删除，不重启服务、不发 modem 命令。
# 老二进制没有 /pair/clients 时，列表退回读文件，只给序号 + 尾号。
#
# 前置保护：正在通话时不允许移除（Go 侧锁内还有空闲/音频会话复核）。

. /usr/share/libubox/jshn.sh

DATA_DIR=/mnt/mu300-disk/extra/airsim/data
CLIENTS="$DATA_DIR/vowlan-clients.json"
AGENT=http://127.0.0.1:7581

call_active() {
	# 不能拿 /status 的 call_active 字段当判据：那个字段的语义是「正在通话 **或**
	# 通话状态查不到」（Go 侧写成 !calls.Available || len(calls.Calls) > 0），
	# modem 一抽风就恒为 true，删除配对被永久锁死，页面还显示「已删除 0 个」。
	# 这里只认「确实有正在进行的通话」：calls 数组里真的有元素。
	curl -s -m 4 "$AGENT/status" 2>/dev/null \
		| jsonfilter -e '@.calls.calls[*]' 2>/dev/null | grep -q .
}

# 优先问 Go（新二进制才有 /pair/clients，能给逐客户端指纹 / last_used / recent）；
# 老二进制上这条会 404，退回读 vowlan-clients.json，只报序号 + 尾号。
list_clients() {
	_remote=$(curl -s -m 4 "$AGENT/pair/clients" 2>/dev/null)
	case "$_remote" in
	*'"clients"'*)
		printf '%s\n' "$_remote"
		return
		;;
	esac
	if [ ! -f "$CLIENTS" ]; then
		printf '%s\n' '{"clients":[]}'
		return
	fi
	# 注意：不能写成 jsonfilter | while，管道后那段在子 shell 里跑，
	# jshn 攒下的数组会随子 shell 一起丢掉 —— 先落临时文件再读。
	tmp=$(mktemp /tmp/airsim-pair.XXXXXX 2>/dev/null || echo /tmp/airsim-pair.$$)
	jsonfilter -e '@[*]' < "$CLIENTS" > "$tmp" 2>/dev/null
	json_init
	json_add_array clients
	idx=0
	while IFS= read -r key; do
		[ -n "$key" ] || continue
		idx=$((idx + 1))
		json_add_object
		json_add_int index "$idx"
		json_add_string fingerprint "$(printf '%s' "$key" | tail -c 9)"
		json_close_object
	done < "$tmp"
	json_close_array
	rm -f "$tmp"
	json_dump
}

remove_clients() {
	IFS= read -r request
	ids=''
	if json_load "$request" 2>/dev/null; then
		json_get_var ids ids
		[ -z "$ids" ] && json_get_var ids indexes
	fi
	ids=$(printf '%s' "$ids" | tr -cd '0-9a-f,')
	if [ -z "$ids" ]; then
		printf '%s\n' '{"ok":false,"error":"未选择要删除的客户端"}'
		return
	fi
	if call_active; then
		printf '%s\n' '{"ok":false,"error":"正在通话，先挂断再删除配对"}'
		return
	fi

	removed=0
	errmsg=''
	for id in $(printf '%s' "$ids" | tr ',' ' '); do
		[ -z "$id" ] && continue
		# 指纹必须是 64 位小写 hex；其余一律拒绝，不把脏值发给 Go。
		if [ ${#id} -ne 64 ] || [ -n "$(printf '%s' "$id" | tr -d '0-9a-f')" ]; then
			errmsg='配对标识无效，请刷新列表'
			continue
		fi
		resp=$(curl -s -m 5 -X POST --data "{\"id\":\"$id\"}" "$AGENT/pair/remove" 2>/dev/null)
		case "$resp" in
			*'"ok":true'*)
				removed=$((removed + 1))
				;;
			*)
				[ -z "$errmsg" ] && errmsg=$(printf '%s' "$resp" | jsonfilter -e '@.error' 2>/dev/null)
				[ -z "$errmsg" ] && errmsg='未能移除配对，请确认音频会话已结束且设备存储可写'
				;;
		esac
	done

	if [ "$removed" -eq 0 ]; then
		json_init
		json_add_boolean ok 0
		json_add_string error "$errmsg"
		json_dump
		return
	fi

	# 删除后再问一次列表，给页面报剩余数量。
	remaining=$(curl -s -m 4 "$AGENT/pair/clients" 2>/dev/null | jsonfilter -e '@.clients[*]' 2>/dev/null | grep -c .)
	json_init
	json_add_boolean ok 1
	json_add_int removed "$removed"
	json_add_int total "$remaining"
	json_dump
}

case "$1" in
	list)
		printf '%s\n' '{"pair_clients":{},"pair_remove":{"ids":"String"}}'
		;;
	call)
		case "$2" in
		pair_clients) list_clients ;;
		pair_remove) remove_clients ;;
		*) exit 1 ;;
		esac
		;;
	*)
		exit 1
		;;
esac
