#!/bin/sh
# AirSIM for F50 —— 音频模块可选件（独立 rpcd 对象 airsim-audio）
#
# 只做两件事：
#   audio_opt_probe  : 报本机内核 / 扩展目录里有哪些驱动包 / 当前内核是否对得上 / 装到几成
#   audio_opt_install: 交给 /usr/libexec/airsim-audioopt-install 去装（后台跑，页面轮询）
#
# 判据是驱动目录 + 目录里 audio_reserve.ko 的 vermagic 与 uname -r 对齐，不看死版本号；
# 这样上游换内核（比如 6.18.60 → 6.18.54）时，页面能直接说清“缺哪一套”。
#
# 固定 tag 的预置可选件里带的内核列在 OPT_KERNELS；一个包可以带多套 modules/<KREL>/。

. /usr/share/libubox/jshn.sh

TAG=audio-opt-v1.0.3
FILE=airsim-f50-audio-opt-1.0.3-k6.18.60+7.3.1.tar.gz
OPT_KERNELS="6.18.60 7.3.1"
EXT=/mnt/mu300-disk/extra/airsim-audio
DIR=/tmp/airsim-audioopt
RUN=/usr/libexec/airsim-audioopt-install
BOOT=/mnt/mu300-disk/boot
PKGDIR=/mnt/mu300-disk/pkg
WANT_KO=25

# 版本比较：a 比 b 新返回 0（awk 退出码），否则 1
ver_gt() {
	awk -v a="$1" -v b="$2" 'BEGIN{
		split(a, x, "."); split(b, y, ".")
		for (i = 1; i <= 3; i++) {
			if (x[i] + 0 > y[i] + 0) exit 0
			if (x[i] + 0 < y[i] + 0) exit 1
		}
		exit 1
	}'
}

# 配件包"检查更新"：查最新 release tag 与资产名。逻辑全在 /usr/libexec/airsim-opt-latest，
# 这里只负责把它吐的 KEY=value 转成 JSON，并把"比本机这个新不新"判出来。
audio_opt_latest() {
	# 已装版本是「设备上实际装的」，不是包里钉的 TAG：拿 TAG 会永远显示"已是最新"
	_cur=$(status_field version)
	[ -n "$_cur" ] || _cur=$(cat "$EXT/audio-opt-version" 2>/dev/null)
	[ -n "$_cur" ] || _cur=${TAG#audio-opt-v}
	_ok=0; _tag=; _ver=; _file=; _at=0; _cool=0; _err='查不到（脱网或被拒）'; _stale=0; _cached=0
	
	# rpcd 的入参走环境变量（force=1 时忽略缓存强制联网）
	_f=''
	case "${force:-}" in 1|true|True|yes) _f=force ;; esac
	eval "$(sh /usr/libexec/airsim-opt-latest audio-opt $_f 2>/dev/null)" 2>/dev/null || :
	ok=${ok:-0}; tag=${tag:-}; ver=${ver:-}; file=${file:-}; checked_at=${checked_at:-0}
	cooldown=${cooldown:-0}; err=${err:-}; stale=${stale:-0}; cached=${cached:-0}
	_up=0
	[ -n "$ver" ] && ver_gt "$ver" "$_cur" && _up=1
	json_init
	json_add_boolean ok "$([ "$ok" = 1 ] && echo 1 || echo 0)"
	json_add_boolean has_update "$_up"
	json_add_string current_ver "$_cur"
	json_add_string latest_tag "$tag"
	json_add_string latest_ver "$ver"
	json_add_string latest_file "$file"
	json_add_string checked_at "$checked_at"
	json_add_boolean cooldown "$([ "$cooldown" = 1 ] && echo 1 || echo 0)"
	json_add_boolean stale "$([ "$stale" = 1 ] && echo 1 || echo 0)"
	json_add_boolean cached "$([ "$cached" = 1 ] && echo 1 || echo 0)"
	json_add_string error "$err"
	json_dump
}

vermagic_of() { grep -ao 'vermagic=[^[:space:]]*' "$1" 2>/dev/null | head -n 1 | cut -d= -f2; }

# 当前内核是否有对得上的驱动目录：目录名 == <krel> 或 <krel>+*，且 audio_reserve.ko 的
# vermagic 前缀等于 <krel>。两者都满足才算，避免只改目录名骗过判断。
match_dir() {
	_k=$1
	for _d in "$EXT/modules/$_k" "$EXT/modules/$_k"+*; do
		[ -d "$_d" ] || continue
		[ -f "$_d/audio_reserve.ko" ] || continue
		_v=$(vermagic_of "$_d/audio_reserve.ko")
		case $_v in
			"$_k"|"$_k "*) echo "$_d"; return 0 ;;
		esac
	done
	return 1
}

ko_count() {
	_d=$(match_dir "$1" 2>/dev/null || true)
	[ -n "$_d" ] || _d=$EXT/modules/$1
	ls "$_d"/*.ko 2>/dev/null | wc -l | tr -d ' '
}

avail_krels() { ls "$EXT/modules" 2>/dev/null | tr '\n' ' '; }

aud_state() {
	if [ -f "$DIR/state" ]; then
		cat "$DIR/state"
	else
		echo idle
	fi
}

aud_msg() {
	if [ -f "$DIR/msg" ]; then
		cat "$DIR/msg"
	else
		echo ''
	fi
}

status_field() {
	[ -f /tmp/airsim-audio-status ] || return 0
	sed -n "s/^$1=//p" /tmp/airsim-audio-status | head -1
}

aud_probe() {
	kver=$(uname -r)
	md=$(match_dir "$kver" 2>/dev/null || true)
	n=$(ko_count "$kver")
	optver=$(status_field version)
	[ -n "$optver" ] || optver=$(cat "$EXT/audio-opt-version" 2>/dev/null || true)
	in_opt=0
	case " $OPT_KERNELS " in *" $kver "*) in_opt=1 ;; esac

	# 两种内核要分开判：
	#   配件包内核（6.18.60 / 7.3.1）—— 按清单件数判，25 件齐了才算装好；
	#   厂商内核（比如 5.4.254）—— 人家镜像自带整套驱动，名字和件数跟清单对不上，
	#   件数一判就误报「缺 1 个」。这时候只信内核自己的口径：audio_reserve 的 missing 参数。
	vendor=0
	[ "$in_opt" = 1 ] || vendor=1
	missing=''
	[ "$vendor" = 1 ] && missing=$(cat /sys/module/audio_reserve/parameters/missing 2>/dev/null | tr -d ' \n')
	ok=0
	if [ "$in_opt" = 1 ]; then
		[ -n "$md" ] && [ "$n" -ge "$WANT_KO" ] && ok=1
	else
		case "$missing" in
			''|*[!0-9]*) ok=0 ;;
			0) [ -n "$md" ] && ok=1 ;;
			*) ok=0 ;;
		esac
	fi
	installed=$ok

	busy=0
	case "$(aud_state)" in
		download|verify|install) busy=1 ;;
	esac

	json_init
	json_add_string action probe
	json_add_boolean installed "$installed"
	json_add_boolean busy "$busy"
	json_add_string state "$(aud_state)"
	json_add_string message "$(aud_msg)"
	json_add_string kernel "$kver"
	json_add_string want_kernel "$kver"
	json_add_boolean kernel_ok "$in_opt"
	json_add_boolean vendor_kernel "$vendor"
	json_add_string audio_missing "$missing"
	json_add_string opt_kernels "$OPT_KERNELS"
	json_add_string available "$(avail_krels)"
	json_add_boolean matched "$([ -n "$md" ] && echo 1 || echo 0)"
	json_add_string match_dir "$md"
	json_add_boolean ext_present "$([ -d "$EXT" ] && echo 1 || echo 0)"
	json_add_int ko_count "$n"
	json_add_int want_ko "$([ "$vendor" = 1 ] && echo 0 || echo "$WANT_KO")"
	json_add_boolean modules_ok "$ok"
	json_add_int ko_missing "$([ "$ok" = 1 ] && echo 0 || echo $((WANT_KO > n ? WANT_KO - n : 0)))"
	json_add_string opt_version "$optver"
	json_add_boolean dsp_present "$([ -x "$EXT/bin/mu300-audio-dsp" ] && echo 1 || echo 0)"
	json_add_string version "$TAG"
	json_add_string file "$FILE"
	json_add_string url "https://github.com/shangjie1998/airsim-f50-openwrt/releases/download/$TAG/$FILE"
	json_add_string label '音频模块（可选配件）'
	json_dump
}

# 读"检查更新"留下的缓存，把查到的最新 tag/ver/file 带出来（本身不联网）
# 输出到 OPT_NEW_TAG / OPT_NEW_VER / OPT_NEW_FILE，缓存不存在或不可用时三者全空
opt_override() {
	OPT_NEW_TAG=; OPT_NEW_VER=; OPT_NEW_FILE=
	_c=/usr/lib/airsim/opt-latest-$1
	[ -f "$_c" ] || return 0
	_val=$(
		. "$_c" 2>/dev/null
		[ "${ok:-0}" = 1 ] || exit 0
		[ -n "${tag:-}" ] || exit 0
		printf '%s|%s|%s' "${tag}" "${ver:-}" "${file:-}"
	)
	[ -n "$_val" ] || return 0
	OPT_NEW_TAG=${_val%%|*}
	_val=${_val#*|}
	OPT_NEW_VER=${_val%%|*}
	OPT_NEW_FILE=${_val#*|}
}

aud_install() {
	case "$(aud_state)" in
		download|verify|install)
			json_init
			json_add_boolean ok 0
			json_add_string error '正在装，等这次的就好'
			json_dump
			return 0
			;;
	esac
	if [ ! -x "$RUN" ]; then
		json_init
		json_add_boolean ok 0
		json_add_string error '本机没有安装器（主包版本太旧）'
		json_dump
		return 0
	fi
	kver=$(uname -r)
	case " $OPT_KERNELS " in
		*" $kver "*) ;;
		*)
			json_init
			json_add_boolean ok 0
			json_add_string error "本机内核 $kver，这个可选件只带 $OPT_KERNELS 的驱动（装上去内核也拒）"
			json_dump
			return 0
			;;
	esac
	if [ ! -d "$EXT" ]; then
		json_init
		json_add_boolean ok 0
		json_add_string error "音频扩展目录不在：$EXT"
		json_dump
		return 0
	fi

	mkdir -p "$DIR"
	echo download > "$DIR/state"
	echo '正在下载安装包' > "$DIR/msg"
	(
		AIRSIM_OPT_TAG=$OPT_LATEST_TAG AIRSIM_OPT_FILE=$OPT_LATEST_FILE \
			sh "$RUN" > "$DIR/log" 2>&1 && echo idle > "$DIR/state" || echo failed > "$DIR/state"
	) &

	json_init
	json_add_boolean ok 1
	json_add_string state download
	json_add_string message '正在下载安装包'
	json_dump
}

sc_run() {
	# 刷机后自检：把「一处一处查」压成一次输出。--fix 只补本机已有源文件的件。
	# 原始 JSON 直接透传，页面端只负责渲染，不在 shell 里二次解析。
	# 两种模式都必须吐 JSON：ubus 端按 JSON 解析，输出人读文本会被判 Invalid argument
	_flags=--json
	[ "${1:-}" = fix ] && _flags='--json --fix'
_out=$(sh /usr/libexec/airsim-postflash-check $_flags 2>/dev/null) || _out='{"ok":false,"error":"自检脚本没在（主包较旧）","items":[]}'
	[ -n "$_out" ] || _out='{"ok":false,"error":"自检脚本没有输出","items":[]}'
	printf '%s\n' "$_out"
}

# 切换内核用：列出本机现成的内核包、boot 里记的是哪一档，给页面拼命令用（只读，不执行切换）
kernel_bundles() {
	json_init
	json_add_string action kernel_bundles
	json_add_string kernel "$(uname -r)"
	json_add_string kernel_short "$(uname -r | cut -d. -f1,2)"
	json_add_string installed "$(cat "$BOOT/installed.kernel" 2>/dev/null)"
	json_add_string installed_tag "$(cat "$BOOT/installed.tag" 2>/dev/null)"
	json_add_array choices
	for k in 5.4 6.18 7.3; do json_add_string "" "$k"; done
	json_close_array
	json_add_array bundles
	for f in "$PKGDIR"/*kernel*.tar.gz /tmp/*kernel*.tar.gz; do
		[ -f "$f" ] || continue
		json_add_object ""
		json_add_string path "$f"
		json_add_string name "$(basename "$f")"
		json_add_int size "$(stat -c %s "$f" 2>/dev/null || echo 0)"
		json_close_object
	done
	json_close_array
	json_dump
}

case "$1" in
	list)
		printf '%s\n' '{"audio_opt_probe":{},"audio_opt_install":{},"audio_opt_latest":{},"selfcheck_run":{},"selfcheck_fix":{},"kernel_bundles":{}}'
		;;
	call)
		case "$2" in
			audio_opt_probe) aud_probe ;;
			audio_opt_install) aud_install ;;
			audio_opt_latest) audio_opt_latest ;;
			selfcheck_run) sc_run ;;
			selfcheck_fix) sc_run fix ;;
			kernel_bundles) kernel_bundles ;;
		esac
		;;
	*)
		;;
esac
