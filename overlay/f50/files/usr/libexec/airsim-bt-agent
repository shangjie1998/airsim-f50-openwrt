#!/usr/bin/env python3
# AirSIM for F50 —— 蓝牙 agent 执行器
#
# 设备上没有 dbus 的 python 绑定、也没有 bt-agent，所以这里用一个常驻的
# bluetoothctl（pty 驱动）同时干三件事：
#   1) 注册 KeyboardDisplay agent —— 别人发起配对时能把请求挂住，等人点同意
#   2) 跑扫描，把扫到的设备写成 devices.json
#   3) 执行 pair / connect / disconnect，把结果写成 result.json
#
# 与 rpcd 的接口只有两个文件：
#   /tmp/airsim-bt-agent/cmd     一行一条命令（FIFO），写进来就执行
#   /tmp/airsim-bt-agent/cmd 由 rpcd 建好 FIFO，本进程以 O_RDWR 打开，不会读空 EOF
#   /tmp/airsim-bt-agent/pending.json  有配对请求时写这里，等人应答
#   /tmp/airsim-bt-agent/decision      同意/拒绝：rpcd 写 yes / no
#   /tmp/airsim-bt-agent/devices.json  扫到的设备
#   /tmp/airsim-bt-agent/result.json   最近一次 pair/connect 的结果
import json
import os
import pty
import re
import select
import subprocess
import sys
import time

DIR = '/tmp/airsim-bt-agent'
LOG = os.path.join(DIR, 'log')
CMD = os.path.join(DIR, 'cmd')
DEVICES = os.path.join(DIR, 'devices.json')
DEVICES_TSV = os.path.join(DIR, 'devices.tsv')
PENDING = os.path.join(DIR, 'pending.json')
DECISION = os.path.join(DIR, 'decision')
RESULT = os.path.join(DIR, 'result.json')
HEART = os.path.join(DIR, 'heartbeat')

ANSI = re.compile(r'\x1b\[[0-9;]*[A-Za-z]')
NEW_RE = re.compile(r'\[NEW\]\s+Device\s+([0-9A-Fa-f:]{17})(?:\s+(.*))?$')
CHG_RE = re.compile(r'\[CHG\]\s+Device\s+([0-9A-Fa-f:]{17})\s+(.*)$')
NAME_PROP_RE = re.compile(r'^\s*Name:\s*(.*)$')
DEL_RE = re.compile(r'\[DEL\]\s+Device\s+([0-9A-Fa-f:]{17})')

def ensure_dir():
    os.makedirs(DIR, exist_ok=True)
    if not os.path.exists(CMD):
        try:
            os.mkfifo(CMD)
        except FileExistsError:
            pass

def write_devices(devs):
    # rpcd 用 shell 读，json 在 busybox 里不好拆，另写一份 TSV：地址<TAB>名字
    sorted_ = sorted(devs.items(), key=lambda kv: -kv[1].get('ts', 0))
    write_json(DEVICES, devs)
    with open(DEVICES_TSV, 'w', encoding='utf-8') as fp:
        for addr, info in sorted_:
            name = str(info.get('name', '')).replace('\t', ' ').replace('\n', ' ')
            fp.write('%s\t%s\t%d\n' % (addr, name, info.get('ts', 0)))

def write_json(path, obj):
    tmp = path + '.tmp'
    with open(tmp, 'w', encoding='utf-8') as fp:
        json.dump(obj, fp, ensure_ascii=False)
    os.rename(tmp, path)

class Agent:
    def __init__(self):
        self.devices = {}
        self.current_addr = ''
        self.pending_until = 0
        self.pending_addr = ''
        master, slave = pty.openpty()
        env = dict(os.environ, TERM='dumb', NO_COLOR='1')
        self.proc = subprocess.Popen(
            ['bluetoothctl', '--agent', 'KeyboardDisplay'],
            stdin=slave, stdout=slave, stderr=slave,
            env=env, close_fds=True, preexec_fn=os.setsid)
        os.close(slave)
        self.fd = master
        self.cmdfd = os.open(CMD, os.O_RDWR | os.O_NONBLOCK)
        self.send('power on')
        time.sleep(1)
        self.send('agent KeyboardDisplay')
        self.send('default-agent')
        time.sleep(1)

    def send(self, line):
        try:
            os.write(self.fd, (line + '\n').encode())
        except OSError:
            pass

    def heartbeat(self):
        # rpcd 靠这个判断「脚本进程在、但它里头的 bluetoothctl 已经死了」这种假活
        try:
            with open(HEART, 'w') as fp:
                fp.write(str(int(time.time())))
        except OSError:
            pass

    def log(self, text):
        try:
            with open(LOG, 'a', encoding='utf-8') as fp:
                fp.write('%s %s\n' % (time.strftime('%m-%d %H:%M:%S'), text))
        except OSError:
            pass

    # ---- 读 pty -----------------------------------------------------------
    def pump(self, timeout=0.3):
        r, _, _ = select.select([self.fd], [], [], timeout)
        if not r:
            return ''
        try:
            data = os.read(self.fd, 4096).decode('utf-8', 'replace')
        except OSError:
            return ''
        return ANSI.sub('', data)

    # ---- 命令 -------------------------------------------------------------
    def read_cmds(self):
        try:
            data = os.read(self.cmdfd, 4096).decode('utf-8', 'replace')
        except (BlockingIOError, OSError):
            return []
        out = []
        for line in data.splitlines():
            line = line.strip()
            if line:
                out.append(line)
        return out

    def handle_cmd(self, line):
        self.log('cmd %s' % line)
        parts = line.split()
        head = parts[0]
        arg = parts[1] if len(parts) > 1 else ''
        if head == 'scan_on':
            self.send('scan on')
        elif head == 'scan_off':
            self.send('scan off')
        elif head == 'pair':
            self.write_result('pair', arg, None, '')
            self.send('pair %s' % arg)
        elif head == 'connect':
            self.write_result('connect', arg, None, '')
            self.send('connect %s' % arg)
        elif head == 'disconnect':
            self.send('disconnect %s' % arg)
        elif head == 'trust':
            self.send('trust %s' % arg)
        elif head == 'devices':
            self.send('devices')
        elif head == 'info':
            self.send('info %s' % arg)
        elif head == 'quit':
            self.proc.terminate()
            sys.exit(0)

    def write_result(self, action, addr, ok, message):
        write_json(RESULT, {
            'ts': int(time.time()),
            'action': action,
            'address': addr.upper(),
            'done': ok is not None,
            'ok': bool(ok),
            'message': message,
        })

    # ---- 解析输出 ---------------------------------------------------------
    def parse(self, text):
        for raw in text.splitlines():
            line = raw.strip()
            if not line:
                continue
            low = line.lower()

            # [NEW] 才是「新发现一台」，后面跟的就是名字；
            # [CHG] 多半是 Class / UUIDs / ManufacturerData 这类属性行，
            # 只有 Name: 那一行才算真名字 —— 不然名字里全是 "UUIDs: 0000..."。
            m = NEW_RE.search(line)
            if m:
                addr = m.group(1).upper()
                name = (m.group(2) or '').strip()
                info = self.devices.get(addr, {})
                if name and not re.match(r'^(UUIDs|Class|RSSI|ManufacturerData|ServiceData|Alias):', name):
                    info['name'] = name
                info['ts'] = int(time.time())
                self.devices[addr] = info
                self.current_addr = addr
                write_devices(self.devices)
            else:
                m = CHG_RE.search(line)
                if m:
                    addr = m.group(1).upper()
                    prop = m.group(2).strip()
                    nm = NAME_PROP_RE.match(prop)
                    info = self.devices.get(addr, {})
                    if nm:
                        info['name'] = nm.group(1).strip()
                    info['ts'] = int(time.time())
                    self.devices[addr] = info
                    self.current_addr = addr
                    write_devices(self.devices)

            # 扫描一停 bluetoothctl 会把扫到的设备全部标 [DEL]；照删的话
            # 页面刚扫完就变空列表。这里不动列表，靠 ts 新鲜度在 rpcd 侧过滤。
            

            # 配对请求：把 passkey / 授权 / 确认都挂住等人点
            kind = None
            code = ''
            m = re.search(r'confirm passkey\s+(\d+)', low)
            if m:
                kind, code = 'passkey', m.group(1)
            elif 'authorize service' in low:
                kind = 'authorize'
            elif 'accept pairing' in low or 'request confirmation' in low:
                kind = 'confirm'
            elif 'request pin code' in low:
                kind = 'pin'
            elif 'confirm' in low and '(yes/no)' in low:
                kind = 'confirm'

            if kind:
                self.ask(kind, code, line)
                continue

            # 动作结果
            if 'pairing successful' in low:
                self.write_result('pair', self.current_addr, True, '已配对')
            elif 'failed to pair' in low or 'not available' in low:
                if self.last_action() == 'pair':
                    self.write_result('pair', self.current_addr, False, '配对失败：对方没响应或已拒绝')
            elif 'connection successful' in low:
                self.write_result('connect', self.current_addr, True, '已连接')
            elif 'failed to connect' in low or 'connection attempt failed' in low:
                if self.last_action() == 'connect':
                    self.write_result('connect', self.current_addr, False, '连接失败')

    def last_action(self):
        try:
            with open(RESULT, encoding='utf-8') as fp:
                return json.load(fp).get('action', '')
        except Exception:
            return ''

    # ---- 等人应答 ---------------------------------------------------------
    def ask(self, kind, code, line):
        addr = self.current_addr
        label = {'passkey': '配对验证码', 'confirm': '确认配对', 'authorize': '服务授权', 'pin': 'PIN 码'}.get(kind, '配对请求')
        write_json(PENDING, {
            'ts': int(time.time()),
            'address': addr,
            'name': self.devices.get(addr, {}).get('name', ''),
            'kind': kind,
            'label': label,
            'passkey': code,
            'text': line,
            'wait': 30,
        })
        self.log('pending %s %s %s' % (kind, addr, code))
        try:
            os.unlink(DECISION)
        except OSError:
            pass

        deadline = time.time() + 30
        answered = None
        while time.time() < deadline:
            # 等待期间继续把 pty 读干净，别让输出堆住
            chunk = self.pump(0.15)
            if chunk:
                self.log('wait> %s' % chunk.strip().replace('\n', ' / ')[:120])
            if os.path.exists(DECISION):
                try:
                    with open(DECISION, encoding='utf-8') as fp:
                        answered = fp.read().strip().lower()
                except OSError:
                    answered = None
                break
        if answered not in ('yes', 'no'):
            answered = 'no'
            self.log('pending timeout -> no')
        self.send(answered)
        self.log('answer %s' % answered)
        try:
            os.unlink(DECISION)
        except OSError:
            pass
        try:
            with open(PENDING, encoding='utf-8') as fp:
                p = json.load(fp)
            p['answered'] = answered
            p['answered_ts'] = int(time.time())
            write_json(PENDING, p)
        except Exception:
            pass

def main():
    ensure_dir()
    agent = Agent()
    agent.log('agent started pid=%d' % os.getpid())
    last_beat = 0
    while True:
        if time.time() - last_beat > 2:
            agent.heartbeat()
            last_beat = time.time()
        if agent.proc.poll() is not None:
            agent.log('bluetoothctl 退出了，脚本跟着退')
            sys.exit(1)
        chunk = agent.pump(0.3)
        if chunk:
            agent.log('out> %s' % chunk.strip().replace('\n', ' / ')[:200])
            agent.parse(chunk)
        for cmd in agent.read_cmds():
            agent.handle_cmd(cmd)

if __name__ == '__main__':
    try:
        main()
    except KeyboardInterrupt:
        pass
