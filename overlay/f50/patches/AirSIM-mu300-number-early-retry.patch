+// numberRetryDue 决定这一秒要不要刷新元数据（顺带读一次 AT+CNUM）。
+// 常规 30 秒一轮；但 AT+CNUM 读的是 SIM 里的 MSISDN，不少运营商卡要等网络
+// 注册完成后才下发，开机后半小时内都可能是空的。所以开机头 3 分钟、号码仍
+// 为空时提到 5 秒一轮，拿到号或超时后自动回到常规节奏。
+func numberRetryDue(n int, uptime time.Duration, number string) bool {
+	if n%30 == 0 {
+		return true
+	}
+	return uptime < 3*time.Minute && number == "" && n%5 == 0
+}
+
+func (a *agent) mu300Number() string {
+	a.mu.RLock()
+	defer a.mu.RUnlock()
+	return a.modem.PhoneNumber
+}
