@@ -0,0 +1,34 @@
+package main
+
+import (
+	"testing"
+	"time"
+)
+
+// 号码刷新节奏：常规 30 秒一轮；开机头 3 分钟且号码为空时 5 秒一轮。
+// 这条判据决定客户端开机后多久能看到本机号码，边界要钉死。
+func TestNumberRetryDue(t *testing.T) {
+	const number = "+8613800138000"
+	cases := []struct {
+		name   string
+		n      int
+		uptime time.Duration
+		number string
+		want   bool
+	}{
+		{"常规节奏 30 秒，已有号", 30, 2 * time.Minute, number, true},
+		{"常规节奏 30 秒，无号", 30, 2 * time.Minute, "", true},
+		{"开机初期无号，5 秒点加速", 5, 10 * time.Second, "", true},
+		{"开机初期无号，非 5 秒点不加速", 7, 10 * time.Second, "", false},
+		{"开机初期已有号，不加速", 5, 10 * time.Second, number, false},
+		{"超过 3 分钟，不加速", 5, 4 * time.Minute, "", false},
+		{"刚好 3 分钟边界，不加速", 5, 3 * time.Minute, "", false},
+		{"第 1 秒，不加速", 1, time.Second, "", false},
+		{"5 秒点但已超时很久，不加速", 5, 30 * time.Minute, "", false},
+	}
+	for _, c := range cases {
+		if got := numberRetryDue(c.n, c.uptime, c.number); got != c.want {
+			t.Errorf("%s: numberRetryDue(%d, %v, %q) = %v, want %v", c.name, c.n, c.uptime, c.number, got, c.want)
+		}
+	}
+}
