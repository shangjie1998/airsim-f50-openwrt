--- a/AirSIM/module/module-agent/mu300_signal.go
+++ b/AirSIM/module/module-agent/mu300_signal.go
@@ -0,0 +1,56 @@
+package main
+
+import (
+	"context"
+	"encoding/json"
+	"os/exec"
+	"time"
+)
+
+// mu300VendorSignalDBM 从厂商 mu300.modem 的 signal 接口取当前服务小区的 RSRP。
+//
+// 为什么不用 AT+CSQ：F50（Unisoc）注册在 5G 独立组网上，AT+CSQ（以及 AT+CESQ 的
+// 前两格）固定回 99,99——CSQ 只覆盖 2G/3G 的测量，NR 不往里填。原厂首页的信号
+// 格数取的也是 mu300.modem 这份数据（sig/lte 里的 rsrp，单位 dBm）。
+//
+// 取不到就返回 nil，上层保持信号未知，页面照旧显示「基带暂未提供」。
+func mu300VendorSignalDBM() *int {
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	output, err := exec.CommandContext(ctx, "ubus", "call", "mu300.modem", "signal", `{"slot":"0"}`).Output()
+	if err != nil {
+		return nil
+	}
+	var payload struct {
+		Sig *struct {
+			Rsrp *float64 `json:"rsrp"`
+		} `json:"sig"`
+		Lte *struct {
+			Rsrp *float64 `json:"rsrp"`
+		} `json:"lte"`
+	}
+	if json.Unmarshal(output, &payload) != nil {
+		return nil
+	}
+	for _, candidate := range []*float64{rsrpOf(payload.Sig), rsrpOf(payload.Lte)} {
+		if candidate == nil {
+			continue
+		}
+		value := int(*candidate)
+		// 0 和正数说明字段没填或单位不对，不当真值用。
+		if value < -140 || value > -30 {
+			continue
+		}
+		return &value
+	}
+	return nil
+}
+
+func rsrpOf(block *struct {
+	Rsrp *float64 `json:"rsrp"`
+}) *float64 {
+	if block == nil {
+		return nil
+	}
+	return block.Rsrp
+}
