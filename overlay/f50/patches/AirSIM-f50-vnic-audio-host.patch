+// audioAdvertiseHost 返回音频 host 模式该让客户端连哪个地址。
+//
+// 原来这里是死值 192.168.225.1（F50 出厂 USB 网段）。机器换成 Wi-Fi STA 或热点
+// 部署以后，这个地址在设备上根本不存在，客户端按它连 PCM 永远连不上，
+// 表现就是"通话能接通、但一点声音都没有"。这跟直连端口、mDNS 广告是同一类问题：
+// 都要跟着当前上行网卡走。见 overlay/f50/patches/ 里 STA 可达性那份补丁。
+//
+// 取值顺序：
+//  1. /tmp/airsim-direct-host —— plugin 切网时写的、它确认在监听的那个地址；
+//  2. 默认路由所在网卡的私有 IPv4（Wi-Fi 模式就是 wlan0，热点模式就是 br-lan）；
+//  3. 本机任意一个私有 IPv4；
+//  4. 实在没有才退回回环，不给客户端一个假地址。
+//
+// 说明：实测 iOS 端并不是按这个地址连 7580，而是走配对时拿到的 8582 网关端口
+// 连 PCM（/status 里 pcm_connection 一直在涨的就是它）。所以这条只是把"死地址"
+// 改成"跟着网卡走"，不是修音频的手段；音频不通的真因是设备侧 DSP 没起来。
+func (a *agent) audioAdvertiseHost() string {
+	if b, err := os.ReadFile("/tmp/airsim-direct-host"); err == nil {
+		if h := strings.TrimSpace(string(b)); net.ParseIP(h) != nil {
+			return h
+		}
+	}
+	readRoute := a.defaultRoute
+	if readRoute == nil {
+		readRoute = readDefaultRoute
+	}
+	if name := strings.TrimSpace(readRoute()["interface"]); name != "" {
+		if dev, err := net.InterfaceByName(name); err == nil {
+			if addrs, err := dev.Addrs(); err == nil {
+				for _, addr := range addrs {
+					if ipnet, ok := addr.(*net.IPNet); ok && ipnet.IP.To4() != nil && ipnet.IP.IsPrivate() {
+						return ipnet.IP.String()
+					}
+				}
+			}
+		}
+	}
+	for _, ipnet := range localIPv4Networks() {
+		if ipnet.IP.To4() != nil && ipnet.IP.IsPrivate() {
+			return ipnet.IP.String()
+		}
+	}
+	return "127.0.0.1"
+}
