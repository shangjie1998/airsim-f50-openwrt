+// 用 api.github.com 取某个 tag 的附件地址（API 地址带 /assets/<id>，
+// 配 Accept: application/octet-stream 能直接下二进制；github.com 上的
+// browser_download_url 在这台设备上访问不到）。
+func releaseAssetURLs(ctx context.Context, tag string) (map[string]string, error) {
+	api := "https://api.github.com/repos/shangjie1998/airsim-f50-openwrt/releases/tags/" + tag
+	req, _ := http.NewRequestWithContext(ctx, "GET", api, nil)
+	req.Header.Set("Accept", "application/vnd.github+json")
+	req.Header.Set("User-Agent", "AirSIM-F50-update")
+	client := &http.Client{Timeout: 15 * time.Second}
+	resp, e := client.Do(req)
+	if e != nil {
+		return nil, errors.New("读取 Release 信息失败，请检查网络后重试")
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode != 200 {
+		return nil, errors.New("Release 不存在或尚未发布完整")
+	}
+	var rel struct {
+		Assets []struct {
+			Name string `json:"name"`
+			URL  string `json:"url"`
+		} `json:"assets"`
+	}
+	if e = json.NewDecoder(resp.Body).Decode(&rel); e != nil {
+		return nil, errors.New("Release 信息解析失败")
+	}
+	out := map[string]string{}
+	for _, a := range rel.Assets {
+		out[a.Name] = a.URL
+	}
+	return out, nil
+}
