#!/bin/sh /etc/rc.common

START=61
STOP=18

USE_PROCD=1

start_service() {
	# 开关闸：/etc/config/f50-bt 里 enabled=0 时直接跳过（关了以后重启仍然是关）
	# 未配置（uci 返回空）按开启处理，保持首次部署即可用。
	if [ "$(uci -q get f50-bt.settings.enabled)" = "0" ]; then
		echo "sprd-bt: 已被开关关闭（f50-bt.settings.enabled=0），跳过启动"
		return 0
		fi

	procd_open_instance
	procd_set_param command /usr/sbin/sprd-bt-attach.sh
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
